d:[["$","title","0",{"children":"Chương 12: Một Tấc Hồng Tim Trong Mưa - Vong Xuyên Điệp - Tàng Thư Các"}],["$","meta","1",{"name":"description","content":"Đọc Chương 12: Một Tấc Hồng Tim Trong Mưa của truyện Vong Xuyên Điệp trên Tàng Thư Các."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?favicon.0x3dzn~oxb6tn.ico","sizes":"256x256","type":"image/x-icon"}],["$","$L10","3",{}]]
5:["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 12: Một Tấc Hồng Tim Trong Mưa"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Mưa tại Vô Tướng Môn không còn rơi rỉ rả nữa, nó trút xuống như thể bầu trời đang nôn ra tất cả những ký ức thừa thãi, từng giọt nước đập vào mái ngói cổ tạo nên một bản giao hưởng u ám, lạnh lẽo, thấm sâu vào da thịt những kẻ đang quét dọn sự thật ở nơi này. Tần Vô Thương đứng dưới hiên thư viện cổ, nhìn sợi chỉ đỏ đang căng cứng giữa không trung, nó không còn rung rinh nữa mà đứng sừng sững như một mũi kim cắm vào thực tại, nối vết sẹo ở cổ tay hắn với một khoảng không xa xăm ở phía bên kia thế giới."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Hắn vừa dùng Dẫn Duyên lần thứ hai."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Và cái giá lại đến."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Lần này không phải tiếng cười của nàng."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"Mà là giọng nói."}],["$","p","5",{"className":"mb-6 text-amber-950","children":"\"Vô Thương ca ca, mau vào đây, mưa to lắm...\" Giọng nói trong trẻo ấy vang lên trong ký ức hắn, nhưng khi cố hình dung âm sắc ấy, trong đầu hắn chỉ còn một khoảng trắng lạnh ngắt. Không còn âm điệu ngọt ngào. Không còn ngữ điệu quen thuộc. Chỉ còn một cảm giác rằng mình từng được gọi bằng một cái tên đầy thương yêu, nhưng không còn nhớ được cái tông giọng ấy rung động thế nào."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, vết sẹo lõm nhỏ lại nhức nhói."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Mỗi lần dùng Dẫn Duyên là một lần hắn đánh mất một mảnh của chính mình để giữ lấy nàng."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"---"}],["$","p","9",{"className":"mb-6 text-amber-950","children":"\"Ngươi lại dùng rồi.\" Tiểu Thất xuất hiện từ màn sương, đôi mắt đen láy không chớp mắt nhìn sợi chỉ đỏ đang mờ đi trên cổ tay hắn. \"Lần này mất gì?\""}],["$","p","10",{"className":"mb-6 text-amber-950","children":"\"Giọng nói.\" Tần Vô Thương đáp, giọng nghẹn lại trong cổ họng. \"Ta không còn nhớ tông giọng của nàng nữa.\""}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Tiểu Thất im lặng một lát, rồi gật đầu. \"Đến một lúc, ngươi sẽ không còn nhớ tại sao mình lại đánh đổi tất cả như thế.\""}],["$","p","12",{"className":"mb-6 text-amber-950","children":"Nó đặt xuống nền đá một bát cháo loãng, vài hạt gạo chìm dưới đáy như những hạt cát trắng. \"Nhưng đến lúc đó, có lẽ ngươi cũng đã quên cả việc mình đang quên.\""}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35"]}]}],"$L36"]}]
11:["$","p","13",{"className":"mb-6 text-amber-950","children":"---"}]
12:["$","p","14",{"className":"mb-6 text-amber-950","children":"Đêm đó, Tần Vô Thương nằm trên chiếu rơm cứng đờ, nhìn vào sợi chỉ đỏ đang mờ dần. Hắn cố gắng nhớ lại giọng nói của nàng, cố gắng nghe lại âm điệu ấy trong trí nhớ, nhưng chỉ nghe thấy tiếng mưa rơi rả rích, tiếng gió rít qua khe đá, và tiếng thở dài của hàng vạn linh hồn đang chờ đợi dưới đáy Vong Xuyên."}]
13:["$","p","15",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại."}]
14:["$","p","16",{"className":"mb-6 text-amber-950","children":"Gọi nàng."}]
15:["$","p","17",{"className":"mb-6 text-amber-950","children":"Lần này, không phải qua Dẫn Duyên."}]
16:["$","p","18",{"className":"mb-6 text-amber-950","children":"Mà là qua ký ức."}]
17:["$","p","19",{"className":"mb-6 text-amber-950","children":"Hắn thấy nàng đứng dưới tán ô đỏ, mưa rơi xối xả xung quanh, nhưng nàng vẫn mỉm cười với hắn, đôi mắt trong suốt như suối nguồn lấp lánh niềm tin vô bờ, như thể nàng biết hắn sẽ đến, dù cả thế gian này đều muốn họ quên đi nhau."}]
18:["$","p","20",{"className":"mb-6 text-amber-950","children":"\"Vô Thương ca ca...\" Giọng nàng vang lên, nhưng lần này không phải trong trẻo."}]
19:["$","p","21",{"className":"mb-6 text-amber-950","children":"Mà là nghẹn ngào."}]
1a:["$","p","22",{"className":"mb-6 text-amber-950","children":"\"Tại sao ngươi lại đổi lấy từng giọt ký ức của mình để tìm ta?\""}]
1b:["$","p","23",{"className":"mb-6 text-amber-950","children":"Hắn muốn đáp. Muốn nói rằng vì nàng quan trọng thế nào. Muốn nói rằng dù có quên sạch sẽ, hắn vẫn sẽ tìm cách nhớ lại."}]
1c:["$","p","24",{"className":"mb-6 text-amber-950","children":"Nhưng miệng hắn khô khốc."}]
1d:["$","p","25",{"className":"mb-6 text-amber-950","children":"Từng chữ từng chữ bỗng trở nên xa lạ."}]
1e:["$","p","26",{"className":"mb-6 text-amber-950","children":"Hắn không còn nhớ cách gọi tên nàng."}]
1f:["$","p","27",{"className":"mb-6 text-amber-950","children":"---"}]
20:["$","p","28",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương tỉnh dậy trong đêm tối, toát mồ hôi lạnh. Sợi chỉ đỏ trên cổ tay đã mờ đi một nửa, nhưng vết sẹo lõm nhỏ vẫn đang rỉ máu, những giọt máu tươi thấm ngược vào sợi chỉ, khiến nó sáng lên mỗi lúc một rực rỡ, đỏ thẫm như hồng ngọc dưới ánh hoàng hôn."}]
21:["$","p","29",{"className":"mb-6 text-amber-950","children":"Hắn bỗng hiểu."}]
22:["$","p","30",{"className":"mb-6 text-amber-950","children":"Dẫn Duyên không chỉ lấy đi ký ức."}]
23:["$","p","31",{"className":"mb-6 text-amber-950","children":"Nó còn lấy đi cả **cách thế** hắn nhớ về nàng."}]
24:["$","p","32",{"className":"mb-6 text-amber-950","children":"Từng lần dùng, nàng trong ký ức hắn sẽ càng mờ đi, càng xa xăm hơn, cho đến một lúc nàng chỉ còn là một bóng hình không tên, không giọng nói, không nụ cười, không ký ức, chỉ còn là một **cảm giác đau đớn** rằng mình từng yêu một người đã bị cả thế gian xóa sạch."}]
25:["$","p","33",{"className":"mb-6 text-amber-950","children":"---"}]
26:["$","p","34",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi Tần Vô Thương tỉnh dậy, trên nền đá cạnh chiếu nằm, dòng chữ cũ đã biến mất."}]
27:["$","p","35",{"className":"mb-6 text-amber-950","children":"Thay vào đó, một dòng chữ mới hiện ra, nét chữ run rẩy như thể người viết đang khóc, nhưng lần này có thêm một chi tiết khiến hắn tim đập thình thịch:"}]
28:["$","p","36",{"className":"mb-6 text-amber-950","children":"**\"Đừng gọi ta nữa. Dù là qua ký ức.\"**"}]
29:["$","p","37",{"className":"mb-6 text-amber-950","children":"**\"Vì mỗi lần ngươi nhớ, Vong Xuyên lại thấy rõ ngươi hơn một chút.\"**"}]
2a:["$","p","38",{"className":"mb-6 text-amber-950","children":"**\"Và khi nó thấy rõ ngươi... nó sẽ lấy đi cả tên của ngươi.\"**"}]
2b:["$","p","39",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói."}]
2c:["$","p","40",{"className":"mb-6 text-amber-950","children":"Hắn biết."}]
2d:["$","p","41",{"className":"mb-6 text-amber-950","children":"Nếu tiếp tục dùng Dẫn Duyên, không chỉ nàng sẽ biến mất khỏi ký ức hắn."}]
2e:["$","p","42",{"className":"mb-6 text-amber-950","children":"Mà cả cái tên **Tần Vô Thương** cũng sẽ hiện lên trên thẻ tre, rồi bị xóa sạch."}]
2f:["$","p","43",{"className":"mb-6 text-amber-950","children":"Hắn sẽ không chỉ mất nàng."}]
30:["$","p","44",{"className":"mb-6 text-amber-950","children":"Hắn sẽ mất chính mình."}]
31:["$","p","45",{"className":"mb-6 text-amber-950","children":"---"}]
32:["$","p","46",{"className":"mb-6 text-amber-950","children":"Nhưng khi nhìn vào sợi chỉ đỏ đang căng ngắt giữa không trung, nối hắn với bóng hình mờ ảo dưới đáy Vong Xuyên, hắn biết mình sẽ không dừng lại."}]
33:["$","p","47",{"className":"mb-6 text-amber-950","children":"Dù có phải quên sạch."}]
