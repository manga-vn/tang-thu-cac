0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 9: Một Nét Tên Người"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương quấn chặt vải lanh quanh cổ tay trái, ép sát vào vết sẹo lõm nhỏ. Hắn cảm thấy từng nhịp tim đập vào lớp vải thô ráp, như thể đang cố đẩy thứ gì đó ra ngoài."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Mười ngày kể từ khi học được nguyên tắc \"không gọi tên người đã bị xóa\", hắn đã quấn cổ tay mỗi sáng. Không phải để che giấu. Mà là để ngăn **máu rơi.**"}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Bởi mỗi giọt máu rơi xuống thẻ tre, Vong Xuyên lại nhìn thấy hắn rõ hơn một chút."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"---"}],["$","p","4",{"className":"mb-6 text-amber-950","children":"Sáng sớm, sương mù lạnh lẽo thấm qua kẽ cửa sổ đá. Tần Vô Thương ngồi dậy, cẩn thận gỡ lớp vải lanh. Vết sẹo lõm nhỏ vẫn đỏ au, những mạch máu nhỏ xung quanh như những nhánh rễ khô. Hắn không dám ấn mạnh. Chỉ nhẹ nhàng day day, cảm nhận cái nhói đau quen thuộc lan tỏa."}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Hắn sợ chính máu của mình."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Không phải sợ đau. Mà là sợ mỗi giọt máu rơi xuống thẻ tre, lại hiện ra thêm một nét của cái tên **Tần Vô Thương.**"}],["$","p","7",{"className":"mb-6 text-amber-950","children":"\"Ngươi lại quấn cổ tay nữa rồi.\""}],["$","p","8",{"className":"mb-6 text-amber-950","children":"Tiểu Thất đứng ở góc phòng, đôi mắt đen láy không chớp mắt nhìn hắn. Đứa trẻ vẫn mặc bộ đạo bào rách nát, trên tay cầm bát cháo loãng nghi ngút khói."}],["$","p","9",{"className":"mb-6 text-amber-950","children":"\"Máu ngươi không phải máu thường.\" Nó đặt bát cháo xuống nền đá, giọng khô khốc. \"Nó là thứ Vong Xuyên đang tìm.\""}],["$","p","10",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt nắm đấm, cổ tay lại nhói đau. \"Ở ngươi là gì?\""}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Tiểu Thất ngồi bệt xuống đối diện hắn, đôi bàn tay gầy guộc vươn ra, ngón tay khẽ chạm vào lớp vải lanh quấn quanh cổ tay hắn."}],["$","p","12",{"className":"mb-6 text-amber-950","children":"\"Máu của một kẻ không có linh căn, nếu chạm vào thẻ tre, đôi khi sẽ khiến một cái tên cũ hiện lại. Nhưng máu của ngươi...\" Nó ngẩng đầu, đôi mắt đen láy nhìn thẳng vào mắt hắn. \"Nó không chỉ hiện tên người khác. Nó còn hiện cả tên của chính ngươi.\""}],["$","p","13",{"className":"mb-6 text-amber-950","children":"Hắn chết lặng."}],["$","p","14",{"className":"mb-6 text-amber-950","children":"\"Vong Xuyên đang tìm ngươi.\" Tiểu Thất tiếp lời, giọng nhẹ đến mức gần như tan vào sương. \"Không phải vì ngươi nhớ nàng. Mà vì máu ngươi có thể **gọi tên** bất kỳ ai đã bị xóa. Kể cả những người mà ngay cả Vong Xuyên cũng tưởng đã quên sạch.\""}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35"]}]}],"$L36"]}],null,"$L37"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"HHZsBH1x4frJs2LPctWw0"}
3:["$","p","15",{"className":"mb-6 text-amber-950","children":"---"}]
4:["$","p","16",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đi ra hiên thư viện, nơi những cuộn thẻ tre xám xịt đang chờ hắn lau chùi."}]
5:["$","p","17",{"className":"mb-6 text-amber-950","children":"Hôm nay, hắn không cầm chổi. Hắn chỉ đứng nhìn những cuộn thẻ, đôi bàn tay gầy guộc run rẩy."}]
6:["$","p","18",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong đang quét lá ở gần đó, bóng hình gầy gò khuất sau màn sương. Lão không ngẩng đầu, chỉ cất giọng khàn đặc vang lên như thể vừa nhai sỏi đá:"}]
7:["$","p","19",{"className":"mb-6 text-amber-950","children":"\"Ngươi đang sợ máu của mình.\""}]
8:["$","p","20",{"className":"mb-6 text-amber-950","children":"Không phải câu hỏi. Là khẳng định."}]
9:["$","p","21",{"className":"mb-6 text-amber-950","children":"\"Phải.\" Tần Vô Thương đáp, giọng nghẹn lại. \"Nếu máu ta rơi xuống thẻ tre, tên ta sẽ hiện ra. Rồi ta cũng sẽ bị xóa như nàng.\""}]
a:["$","p","22",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong dừng tay, đôi mắt u uẩn nằm sâu trong hốc mắt nhìn thẳng vào hắn."}]
b:["$","p","23",{"className":"mb-6 text-amber-950","children":"\"Vậy ngươi phải học cách bám vào một vật, thay vì bám vào một cái tên.\" Lão vỗ nhẹ vào cây chổi tre trong tay. \"Không phải nhớ bằng máu. Cũng không phải nhớ bằng tên.\""}]
c:["$","p","24",{"className":"mb-6 text-amber-950","children":"\"Nhớ bằng cách nào?\""}]
d:["$","p","25",{"className":"mb-6 text-amber-950","children":"\"Nhớ bằng **hình**.\" Mạc Trường Phong đứng dậy, bóng hình gầy gò sừng sững giữa màn sương. \"Ngươi nhìn cánh hoa anh đào, ngươi nhớ nàng mặc váy đỏ. Ngươi nhìn chiếc ô giấy, ngươi nhớ giọng nói trong trẻo của nàng. Đó là **hình**. Không tên. Không gọi. Chỉ có hình ảnh in sâu vào lòng.\""}]
e:["$","p","26",{"className":"mb-6 text-amber-950","children":"Hắn im lặng rất lâu."}]
f:["$","p","27",{"className":"mb-6 text-amber-950","children":"Rồi hắn bước đến bên bờ ao đen ngòm, nơi một cánh hoa anh đào đỏ như máu đang trôi lững lờ trên mặt nước. Hắn khụy xuống, ngón tay khẽ chạm vào cánh hoa mỏng manh."}]
10:["$","p","28",{"className":"mb-6 text-amber-950","children":"Không có máu rỉ ra."}]
11:["$","p","29",{"className":"mb-6 text-amber-950","children":"Không có hơi ấm."}]
12:["$","p","30",{"className":"mb-6 text-amber-950","children":"Chỉ có một cơn nhói rất sâu, như thể ký ức ấy không nằm trong đầu hắn, mà nằm trong xương."}]
13:["$","p","31",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại."}]
14:["$","p","32",{"className":"mb-6 text-amber-950","children":"Trong đầu hắn hiện ra hình ảnh nàng dưới tán ô đỏ. Đôi mắt trong suốt như suối nguồn. Giọng nói trong trẻo: *\"Vô Thương ca ca, mau vào đây, mưa to lắm...\"*"}]
15:["$","p","33",{"className":"mb-6 text-amber-950","children":"Hắn không gọi tên nàng."}]
16:["$","p","34",{"className":"mb-6 text-amber-950","children":"Hắn chỉ nhớ **hình**."}]
17:["$","p","35",{"className":"mb-6 text-amber-950","children":"---"}]
18:["$","p","36",{"className":"mb-6 text-amber-950","children":"Chiều tà, Tần Vô Thương ngồi bên hiên thư viện, cầm một cánh hoa anh đào trên tay. Hắn nhìn nó rất lâu, cố gắng giữ cho máu không rỉ ra khỏi cổ tay."}]
19:["$","p","37",{"className":"mb-6 text-amber-950","children":"Hắn thử dùng cánh hoa để nhớ nàng mà không gọi tên."}]
1a:["$","p","38",{"className":"mb-6 text-amber-950","children":"Nó hiệu quả."}]
1b:["$","p","39",{"className":"mb-6 text-amber-950","children":"Hắn có thể nhớ nàng cười, nhớ nàng đứng dưới mưa, nhớ tiếng gọi *\"Vô Thương ca ca\"* mà không cần thốt ra bất kỳ từ ngữ nào."}]
1c:["$","p","40",{"className":"mb-6 text-amber-950","children":"Nhưng chính khi hắn nhớ nàng quá rõ, quá sắc nét, một cảm giác lạnh toát chạy dọc sống lưng."}]
1d:["$","p","41",{"className":"mb-6 text-amber-950","children":"Hắn mở bàn tay trái, nới lỏng lớp vải lanh."}]
1e:["$","p","42",{"className":"mb-6 text-amber-950","children":"Vết sẹo lõm nhỏ không có máu rỉ ra."}]
1f:["$","p","43",{"className":"mb-6 text-amber-950","children":"Nhưng trên bề mặt tre nhẵn bóng của cuộn thẻ tre đang cầm trên tay phải, bỗng hiện ra thêm một nét nữa."}]
20:["$","p","44",{"className":"mb-6 text-amber-950","children":"Không phải do máu rơi."}]
21:["$","p","45",{"className":"mb-6 text-amber-950","children":"Mà do **hắn vừa nhớ nàng quá rõ.**"}]
22:["$","p","46",{"className":"mb-6 text-amber-950","children":"Từng nét một, như thể có một ngọn bút vô hình đang viết lên bề mặt tre:"}]
23:["$","p","47",{"className":"mb-6 text-amber-950","children":"Một nét mực đỏ hiện ra.\nRất mảnh.\nRất cũ.\nGiống nét đầu tiên của chữ **秦**."}]
24:["$","p","48",{"className":"mb-6 text-amber-950","children":"Nhưng Tần Vô Thương lại cảm thấy sống lưng lạnh toát hơn bao giờ hết."}]
25:["$","p","49",{"className":"mb-6 text-amber-950","children":"Hắn biết, ngay cả khi hắn ngăn máu rơi, chỉ cần hắn nhớ nàng quá rõ, cái tên của hắn cũng sẽ tự hiện ra trên thẻ tre."}]
26:["$","p","50",{"className":"mb-6 text-amber-950","children":"Vong Xuyên không cần máu của hắn."}]
27:["$","p","51",{"className":"mb-6 text-amber-950","children":"Nó chỉ cần hắn **nhớ.**"}]
28:["$","p","52",{"className":"mb-6 text-amber-950","children":"---"}]
29:["$","p","53",{"className":"mb-6 text-amber-950","children":"Đêm đó, Tần Vô Thương nằm trên chiếu rơm, cánh hoa anh đào đặt lên ngực."}]
2a:["$","p","54",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại, thì thầm trong bóng tối:"}]
2b:["$","p","55",{"className":"mb-6 text-amber-950","children":"*\"Ta sẽ không gọi tên nàng.\"*"}]
2c:["$","p","56",{"className":"mb-6 text-amber-950","children":"*\"Ta sẽ không để máu rơi.\"*"}]
2d:["$","p","57",{"className":"mb-6 text-amber-950","children":"*\"Nhưng ta cũng sẽ không quên hình bóng nàng.\"*"}]
2e:["$","p","58",{"className":"mb-6 text-amber-950","children":"Ngay khi hắn thì thầm câu đó, từ phía thư viện cổ, một luồng gió lạnh thổi qua, làm tắt ngấm ngọn đèn dầu duy nhất trong phòng."}]
2f:["$","p","59",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi Tần Vô Thương tỉnh dậy, trên nền đá cạnh chiếu nằm, một dòng chữ mới hiện ra, nét chữ run rẩy như thể người viết đang khóc:"}]
30:["$","p","60",{"className":"mb-6 text-amber-950","children":"**\"Ta nhìn thấy một nét tên ngươi đêm qua.\"**"}]
31:["$","p","61",{"className":"mb-6 text-amber-950","children":"**\"Đừng nhớ ta quá rõ... Vong Xuyên sẽ tìm thấy ngươi.\"**"}]
32:["$","p","62",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói."}]
33:["$","p","63",{"className":"mb-6 text-amber-950","children":"Hắn biết, từ nay về sau, hắn không chỉ phải giữ lấy tên mình."}]
34:["$","p","64",{"className":"mb-6 text-amber-950","children":"Hắn còn phải học cách giữ nàng trong lòng như giữ một ngọn đèn sau sương."}]
35:["$","p","65",{"className":"mb-6 text-amber-950","children":"Đủ sáng để không tắt.\nNhưng không sáng đến mức dẫn Vong Xuyên tìm tới."}]
36:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-8","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 8: Tên Là Thứ Dễ Mất Nhất"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-10","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 10: Sợi Chỉ Đỏ Trong Mưa"}]]}]}]]}]}]}]
37:["$","$L38",null,{"children":["$","$39",null,{"name":"Next.MetadataOutlet","children":"$@3a"}]}]
3a:null
