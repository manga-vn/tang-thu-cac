0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 8: Tên Là Thứ Dễ Mất Nhất"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương bắt đầu học cách nhớ nàng mà không gọi tên nàng."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Mỗi sáng, khi lau chùi những cuộn thẻ tre xám xịt, hắn nhìn vào bề mặt nhẵn bóng, cố gắng không nghĩ đến hai chữ kia. Nhưng hình ảnh chiếc ô đỏ, đôi mắt trong suốt như suối nguồn, và giọng nói trong trẻo: *\"Vô Thương ca ca...\"* vẫn hiện rõ mồn một."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Hắn không gọi tên nàng."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Nhưng hắn nhớ."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"---"}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Một buổi sáng sương mù dày đặc, Tần Vô Thương tìm đến Mạc Trường Phong đang quét lá bên vệ đường."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"\"Ngươi...\" Hắn bắt đầu, giọng nghẹn lại. \"Làm sao để nhớ mà không đánh thức?\""}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong không ngẩng đầu, đôi bàn tay dài gầy vẫn cầm cây chổi tre quét trên nền đá. \"Ngươi đang làm.\""}],["$","p","8",{"className":"mb-6 text-amber-950","children":"\"Ta không gọi tên nàng.\""}],["$","p","9",{"className":"mb-6 text-amber-950","children":"\"Thì ngươi đang làm đúng.\" Mạc Trường Phong đáp, giọng khàn đặc vang lên như thể vừa nhai sỏi đá. \"Ở Vô Tướng Môn, nguyên tắc đầu tiên là: **Không được gọi tên người đã bị xóa.**\""}],["$","p","10",{"className":"mb-6 text-amber-950","children":"Hắn dừng tay, nhìn thẳng vào đôi mắt u uẩn nằm sâu trong hốc mắt kia. \"Tại sao?\""}],["$","p","11",{"className":"mb-6 text-amber-950","children":"\"Vì tên là thứ dễ mất nhất.\" Mạc Trường Phong ngẩng đầu, đôi mắt già nua không chớp mắt nhìn hắn. \"Khi ngươi gọi tên một người đã bị Vong Xuyên xóa, ngươi đang dùng thứ duy nhất còn sót lại để neo họ vào thế gian. Nhưng mỗi lần ngươi gọi, Vong Xuyên sẽ cảm nhận được sợi dây kết nối đó, và nó sẽ kéo họ xuống sâu hơn.\""}],["$","p","12",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói."}],["$","p","13",{"className":"mb-6 text-amber-950","children":"\"Vậy phải nhớ nàng bằng cách nào?\""}],["$","p","14",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong nhìn xuống cây chổi trong tay mình. \"Bằng vật chứng. Không phải bằng tên.\""}],["$","p","15",{"className":"mb-6 text-amber-950","children":"\"Vật chứng?\""}],["$","p","16",{"className":"mb-6 text-amber-950","children":"\"Thẻ tre này.\" Hắn vỗ nhẹ vào cuộn thẻ đang cầm. \"Cây chổi này. Chiếc ô đỏ. Cánh hoa anh đào. Những thứ không có tên, nhưng lại mang dấu ấn của người từng tồn tại.\""}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c"]}]}],"$L3d"]}],null,"$L3e"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"HHZsBH1x4frJs2LPctWw0"}
3:["$","p","17",{"className":"mb-6 text-amber-950","children":"Hắn đứng dậy, bóng hình gầy gò khuất sau màn sương, giọng vang lên như thể đang nói với một người sắp chết:"}]
4:["$","p","18",{"className":"mb-6 text-amber-950","children":"\"Ngươi phải học cách ghi nhớ bằng vật chứng. Cây chổi, thẻ tre, cánh hoa, chiếc ô đỏ... tất cả sẽ trở thành **vật neo ký ức**. Khi ngươi nhìn thấy chúng, ngươi sẽ nhớ. Nhưng ngươi sẽ không bao giờ gọi tên.\""}]
5:["$","p","19",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đứng sững giữa sân thư viện, màn sương lạnh lẽo thấm vào da thịt."}]
6:["$","p","20",{"className":"mb-6 text-amber-950","children":"Hắn hiểu."}]
7:["$","p","21",{"className":"mb-6 text-amber-950","children":"---"}]
8:["$","p","22",{"className":"mb-6 text-amber-950","children":"Từ hôm đó, Tần Vô Thương thay đổi cách lau chùi thẻ tre."}]
9:["$","p","23",{"className":"mb-6 text-amber-950","children":"Hắn không nhìn vào bề mặt nhẵn bóng để tìm tên nàng. Mà hắn nhìn vào những vết xước trên thẻ tre, những vết rạn nứt như những nếp nhăn trên trán một người già. Hắn nhìn vào màu xám xịt của thẻ, cảm nhận sự lạnh toát tỏa ra, như thể mỗi cuộn thẻ đều chứa đựng một bí mật kinh khủng."}]
a:["$","p","24",{"className":"mb-6 text-amber-950","children":"Mỗi sáng, Tiểu Thất vẫn đưa cho hắn bát cháo loãng, vài hạt gạo chìm dưới đáy như những hạt cát trắng."}]
b:["$","p","25",{"className":"mb-6 text-amber-950","children":"\"Ngươi đang làm gì?\" Tiểu Thất hỏi vào sáng thứ mười lăm, đôi mắt đen láy không chớp mắt nhìn những cuộn thẻ tre hắn đang sắp xếp theo một trật tự kỳ lạ."}]
c:["$","p","26",{"className":"mb-6 text-amber-950","children":"\"Đang học cách nhớ.\" Tần Vô Thương đáp, giọng không cảm xúc. \"Bằng vật chứng. Không bằng tên.\""}]
d:["$","p","27",{"className":"mb-6 text-amber-950","children":"Tiểu Thất im lặng một lát, rồi gật đầu. \"Ở Vô Tướng Môn, kẻ không có linh căn như chúng ta chỉ có một việc: quét dọn những gì còn sót lại của sự thật. Nhưng ngươi đang làm việc đó theo một cách khác.\""}]
e:["$","p","28",{"className":"mb-6 text-amber-950","children":"\"Khác thế nào?\""}]
f:["$","p","29",{"className":"mb-6 text-amber-950","children":"Tiểu Thất nhìn những cuộn thẻ được hắn xếp lại rất lâu."}]
10:["$","p","30",{"className":"mb-6 text-amber-950","children":"\"Ngươi đang tự buộc mình vào chúng.\""}]
11:["$","p","31",{"className":"mb-6 text-amber-950","children":"\"Buộc?\""}]
12:["$","p","32",{"className":"mb-6 text-amber-950","children":"\"Ừ. Buộc càng nhiều, ngày sau đứt càng đau.\""}]
13:["$","p","33",{"className":"mb-6 text-amber-950","children":"Hắn không đáp."}]
14:["$","p","34",{"className":"mb-6 text-amber-950","children":"Chỉ tiếp tục sắp xếp."}]
15:["$","p","35",{"className":"mb-6 text-amber-950","children":"---"}]
16:["$","p","36",{"className":"mb-6 text-amber-950","children":"Đêm đó, khi Tần Vô Thương đang lau chùi những cuộn thẻ tre cuối cùng, một cuộn thẻ từ trên đống thẻ chất cao như núi bỗng rơi xuống, lăn một vòng tròn, dừng lại ngay mép chân hắn."}]
17:["$","p","37",{"className":"mb-6 text-amber-950","children":"Hắn khụy xuống nhặt lên."}]
18:["$","p","38",{"className":"mb-6 text-amber-950","children":"Không có chữ. Không có họa tiết. Chỉ có bề mặt tre nhẵn bóng đến mức hắn có thể nhìn thấy khuôn mặt hốc hác của mình trong đó."}]
19:["$","p","39",{"className":"mb-6 text-amber-950","children":"Nhưng khi hắn nhìn kỹ hơn, từ vết sẹo lõm nhỏ ở cổ tay áo, một giọt máu tươi bỗng rỉ ra, rơi trực tiếp lên bề mặt tre nhẵn bóng."}]
1a:["$","p","40",{"className":"mb-6 text-amber-950","children":"Không thấm."}]
1b:["$","p","41",{"className":"mb-6 text-amber-950","children":"Giọt máu lăn trên mặt tre như giọt nước trên lá sen, để lại một vệt đỏ tươi. Rồi vệt đỏ bắt đầu biến đổi."}]
1c:["$","p","42",{"className":"mb-6 text-amber-950","children":"Từng nét một, như thể có một ngọn bút vô hình đang viết lên bề mặt tre:"}]
1d:["$","p","43",{"className":"mb-6 text-amber-950","children":"Chỉ mới hiện được vài nét rời rạc."}]
1e:["$","p","44",{"className":"mb-6 text-amber-950","children":"Chưa đủ thành chữ."}]
1f:["$","p","45",{"className":"mb-6 text-amber-950","children":"Nhưng Tần Vô Thương lại cảm thấy sống lưng lạnh toát."}]
20:["$","p","46",{"className":"mb-6 text-amber-950","children":"Hắn biết, nếu để những nét đỏ kia viết tiếp, cái tên hiện ra sẽ không phải của Trần Đại Thụ, cũng không phải của cô bé dưới tán ô."}]
21:["$","p","47",{"className":"mb-6 text-amber-950","children":"Mà là của hắn."}]
22:["$","p","48",{"className":"mb-6 text-amber-950","children":"Hắn vội vàng lau sạch vết máu trên thẻ tre, cuộn lại, định bọc vải lại như cũ."}]
23:["$","p","49",{"className":"mb-6 text-amber-950","children":"Nhưng một cảm giác lạnh toát chạy dọc sống lưng."}]
24:["$","p","50",{"className":"mb-6 text-amber-950","children":"Nếu tên hắn cũng xuất hiện trên những cuộn thẻ tre này..."}]
25:["$","p","51",{"className":"mb-6 text-amber-950","children":"Nếu một ngày nào đó, hắn cũng bị Vong Xuyên xóa sạch..."}]
26:["$","p","52",{"className":"mb-6 text-amber-950","children":"Liệu nàng có còn ai để nhớ đến mình?"}]
27:["$","p","53",{"className":"mb-6 text-amber-950","children":"---"}]
28:["$","p","54",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi Tần Vô Thương tỉnh dậy, trên nền đá cạnh chiếu nằm, một dòng chữ mới hiện ra, nét chữ run rẩy như thể người viết đang khóc:"}]
29:["$","p","55",{"className":"mb-6 text-amber-950","children":"**\"Đừng để nó viết tiếp.\"**"}]
2a:["$","p","56",{"className":"mb-6 text-amber-950","children":"**\"Nếu ngươi cũng bị xóa, ai sẽ nhớ ta?\"**"}]
2b:["$","p","57",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói."}]
2c:["$","p","58",{"className":"mb-6 text-amber-950","children":"Hắn biết, hắn không chỉ đang chiến đấu để cứu nàng."}]
2d:["$","p","59",{"className":"mb-6 text-amber-950","children":"Mà còn đang chiến đấu để giữ lấy chính tên mình."}]
2e:["$","p","60",{"className":"mb-6 text-amber-950","children":"---"}]
2f:["$","p","61",{"className":"mb-6 text-amber-950","children":"Đêm đó, lần đầu tiên, Tần Vô Thương nhìn vào cây chổi tre, những cuộn thẻ tre xám xịt, và cánh hoa anh đào đỏ như máu nằm lặng bên cạnh chiếu."}]
30:["$","p","62",{"className":"mb-6 text-amber-950","children":"Tất cả đều là **vật neo ký ức**."}]
31:["$","p","63",{"className":"mb-6 text-amber-950","children":"Tất cả đều đang chờ đợi một ngày hắn đủ mạnh để đối đầu với Vong Xuyên."}]
32:["$","p","64",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại, thì thầm trong bóng tối:"}]
33:["$","p","65",{"className":"mb-6 text-amber-950","children":"*\"Ta sẽ không để tên mình bị xóa.\"*"}]
34:["$","p","66",{"className":"mb-6 text-amber-950","children":"*\"Ta sẽ nhớ nàng.\"*"}]
35:["$","p","67",{"className":"mb-6 text-amber-950","children":"*\"Dù có phải dùng cả máu trong cổ tay này.\"*"}]
36:["$","p","68",{"className":"mb-6 text-amber-950","children":"---"}]
37:["$","p","69",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, trên nền đá, dòng chữ cũ đã biến mất."}]
38:["$","p","70",{"className":"mb-6 text-amber-950","children":"Chỉ còn lại một cánh hoa anh đào đỏ như máu, nằm lặng lẽ trên nền đá lạnh."}]
39:["$","p","71",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cầm lấy cánh hoa, ngón tay chạm vào cánh hoa mỏng manh, đầu ngón tay lại đau như chạm vào một vết thương cũ."}]
3a:["$","p","72",{"className":"mb-6 text-amber-950","children":"Hắn biết, từ nay về sau, hắn không chỉ phải nhớ nàng."}]
3b:["$","p","73",{"className":"mb-6 text-amber-950","children":"Hắn còn phải giữ lấy chính mình."}]
3c:["$","p","74",{"className":"mb-6 text-amber-950","children":"Bởi nếu ngay cả cái tên Tần Vô Thương cũng bị xóa, trên đời này sẽ không còn ai biết từng có một cô bé đứng dưới chiếc ô màu đỏ."}]
3d:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-7","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 7: Đừng Nhớ Ta Nữa"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-9","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 9: Một Nét Tên Người"}]]}]}]]}]}]}]
