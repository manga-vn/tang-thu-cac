0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 5: Thẻ Tre Không Tên"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Mười ngày trôi qua."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương mỗi sáng đều lau chùi những cuộn thẻ tre xám xịt ở hiên thư viện cổ. Mười ngày, không một ngày nghỉ, cũng không một lời trách móc hay khen ngợi từ bất kỳ ai. Hắn như bóng ma của chính mình, lặng lẽ quét dọn những gì còn sót lại của sự thật."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Tiểu Thất thỉnh thoảng xuất hiện, đưa cho hắn bát cháo loãng, rồi lại biến mất vào màn sương. Đứa trẻ vẫn mặc bộ đạo bào rách nát, tấm thẻ gỗ trước ngực vết dao trắng bệch, đôi mắt đen láy không chớp mắt nhìn hắn mỗi lần đưa đồ ăn."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"\"Ngươi có thấy gì lạ không?\" Tiểu Thất hỏi vào sáng thứ mười."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"\"Lạ?\" Tần Vô Thương ngẩng đầu, đôi bàn tay gầy guộc vẫn đang lau chùi bề mặt thẻ tre lạnh toát. \"Chỉ có bụi.\""}],["$","p","5",{"className":"mb-6 text-amber-950","children":"\"Được rồi.\" Tiểu Thất gật đầu, bóng hình nhỏ bé khuất sau màn sương."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Hắn tiếp tục lau chùi."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Đến trưa, một cuộn thẻ tre từ trên đống thẻ chất cao như núi bỗng rơi xuống, vải bọc ngoài bị rách toạc, lộ ra mặt tre nhẵn bóng như gương cổ."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương khụy xuống nhặt lên."}],["$","p","9",{"className":"mb-6 text-amber-950","children":"Không có chữ. Không có họa tiết. Chỉ có bề mặt tre nhẵn bóng đến mức hắn có thể nhìn thấy khuôn mặt hốc hác của mình trong đó."}],["$","p","10",{"className":"mb-6 text-amber-950","children":"Nhưng khi hắn nhìn kỹ hơn, khuôn mặt trong gương cổ không phải của hắn."}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Mà là một người đàn ông trung niên, gương mặt hiền từ, đôi mắt nhắm nghiền, như thể đang ngủ vĩnh viễn."}],["$","p","12",{"className":"mb-6 text-amber-950","children":"Hắn giật mình buông tay."}],["$","p","13",{"className":"mb-6 text-amber-950","children":"Cuộn thẻ tre rơi xuống nền đá, lăn một vòng tròn, dừng lại ngay mép chân hắn. Từ vết sẹo lõm nhỏ ở cổ tay áo, một giọt máu tươi bỗng rỉ ra, rơi trực tiếp lên bề mặt tre nhẵn bóng."}],["$","p","14",{"className":"mb-6 text-amber-950","children":"Không thấm."}],["$","p","15",{"className":"mb-6 text-amber-950","children":"Giọt máu lăn trên mặt tre như giọt nước trên lá sen, để lại một vệt đỏ tươi rực rỡ. Rồi vệt đỏ bắt đầu biến đổi."}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34"]}]}],"$L35"]}],null,"$L36"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"HHZsBH1x4frJs2LPctWw0"}
3:["$","p","16",{"className":"mb-6 text-amber-950","children":"Từng nét một, như thể có một ngọn bút vô hình đang viết lên bề mặt tre:"}]
4:["$","p","17",{"className":"mb-6 text-amber-950","children":"**Trần Đại Thụ.**"}]
5:["$","p","18",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương chết lặng."}]
6:["$","p","19",{"className":"mb-6 text-amber-950","children":"Trần Đại Thụ."}]
7:["$","p","20",{"className":"mb-6 text-amber-950","children":"Hắn lục tìm trong ký ức mờ mịt của mình. Mười năm trước, trong trận mưa lớn nhất thế kỷ, có một người đàn ông trong thôn đã chết. Hắn còn nhớ lúc nhỏ từng nghe cha mẹ thì thầm: *\"Trần bá gia chết rồi, chết ngay trong cái đêm mưa ấy, để lại vợ và đứa con gái nhỏ...\"*"}]
8:["$","p","21",{"className":"mb-6 text-amber-950","children":"Đứa con gái nhỏ ấy là ai?"}]
9:["$","p","22",{"className":"mb-6 text-amber-950","children":"Hắn không nhớ."}]
a:["$","p","23",{"className":"mb-6 text-amber-950","children":"Không phải vì chuyện đã quá lâu."}]
b:["$","p","24",{"className":"mb-6 text-amber-950","children":"Mà là vì nơi đáng lẽ phải có cái tên ấy, trong đầu hắn chỉ còn một khoảng trắng lạnh buốt."}]
c:["$","p","25",{"className":"mb-6 text-amber-950","children":"Nhưng ngay khi nhìn thấy ba chữ Trần Đại Thụ, lồng ngực hắn bỗng nhói đau. Một mảnh ký ức vụn vỡ hiện lên:"}]
d:["$","p","26",{"className":"mb-6 text-amber-950","children":"Mưa xối xả.\nTiếng gõ cộc cộc từ chiếc quan tài gỗ mục.\nMột cô bé đứng dưới tán ô đỏ, đôi mắt trong suốt nhìn hắn, giọng nói trong trẻo vang lên: *\"Vô Thương ca ca, mau vào đây, mưa to lắm...\"*"}]
e:["$","p","27",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt cuộn thẻ tre."}]
f:["$","p","28",{"className":"mb-6 text-amber-950","children":"Hắn không nhớ tên nàng."}]
10:["$","p","29",{"className":"mb-6 text-amber-950","children":"Nhưng hắn biết, nàng từng tồn tại."}]
11:["$","p","30",{"className":"mb-6 text-amber-950","children":"Hắn biết, nàng là đứa con gái nhỏ của Trần Đại Thụ — người mà cả thế gian xóa sạch khỏi ký ức."}]
12:["$","p","31",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, giọt máu từ vết sẹo rơi thêm một giọt nữa lên thẻ tre."}]
13:["$","p","32",{"className":"mb-6 text-amber-950","children":"Trên bề mặt, dưới cái tên **Trần Đại Thụ**, hiện ra thêm một dòng chữ nhỏ xíu:"}]
14:["$","p","33",{"className":"mb-6 text-amber-950","children":"*Năm Chuẩn Châu thứ mười, ngày mưa không tạnh. Tên này bị đưa vào Vong Xuyên.*"}]
15:["$","p","34",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương nhìn dòng chữ, tim đập thình thịch."}]
16:["$","p","35",{"className":"mb-6 text-amber-950","children":"Mười năm trước. Đúng vào cái đêm mưa ấy. Đêm mà chiếc quan tài gỗ mục tự nhiên xuất hiện ở góc vườn nhà hắn. Đêm mà mẹ hắn nắm chặt tay hắn, móng tay lạnh ngắt như ngâm trong nước giếng sâu, bảo: *\"Thương nhi, sau này nếu con nghe thấy có người gọi tên mình trong mưa... đừng trả lời.\"*"}]
17:["$","p","36",{"className":"mb-6 text-amber-950","children":"Hắn bỗng hiểu ra."}]
18:["$","p","37",{"className":"mb-6 text-amber-950","children":"Không phải mẹ sợ hắn trả lời người lạ."}]
19:["$","p","38",{"className":"mb-6 text-amber-950","children":"Mà là sợ hắn trả lời **nàng.**"}]
1a:["$","p","39",{"className":"mb-6 text-amber-950","children":"Cô bé đứng dưới tán ô đỏ."}]
1b:["$","p","40",{"className":"mb-6 text-amber-950","children":"Đứa con gái nhỏ của Trần Đại Thụ — người mà cả thế gian đã quên sạch tên, quên cả khuôn mặt, chỉ còn lại tiếng gọi *\"Vô Thương ca ca\"* vọng lên từ dưới đáy hồ cổ."}]
1c:["$","p","41",{"className":"mb-6 text-amber-950","children":"Hắn vội vàng lau sạch vết máu trên thẻ tre, cuộn lại, định bọc vải lại như cũ."}]
1d:["$","p","42",{"className":"mb-6 text-amber-950","children":"\"Ngươi làm gì thế?\""}]
1e:["$","p","43",{"className":"mb-6 text-amber-950","children":"Tiểu Thất đứng sau lưng hắn, không biết từ bao giờ. Đôi mắt đen láy nhìn thẳng vào cuộn thẻ tre trên tay hắn."}]
1f:["$","p","44",{"className":"mb-6 text-amber-950","children":"\"Ta... vô tình làm rơi.\" Tần Vô Thương đưa cuộn thẻ tre ra, cố giấu vết máu còn sót lại."}]
20:["$","p","45",{"className":"mb-6 text-amber-950","children":"Tiểu Thất không nhận lấy. Nó nhìn thẳng vào mắt hắn, giọng khô khốc: \"Ngươi vừa mở cái gì thế? Chỉ có kẻ không có linh căn mới nhìn thấy được cái tên đó...\""}]
21:["$","p","46",{"className":"mb-6 text-amber-950","children":"\"Tên gì?\" Hắn hỏi."}]
22:["$","p","47",{"className":"mb-6 text-amber-950","children":"\"Tên của người đã bị thế gian lãng quên.\" Tiểu Thất nhìn cuộn thẻ tre. \"Đừng nhìn lâu.\""}]
23:["$","p","48",{"className":"mb-6 text-amber-950","children":"\"Vì sao?\""}]
24:["$","p","49",{"className":"mb-6 text-amber-950","children":"\"Vì khi ngươi còn nhớ họ, họ sẽ bắt đầu nhớ lại chính mình.\""}]
25:["$","p","50",{"className":"mb-6 text-amber-950","children":"Nó im lặng một lát, rồi nói tiếp:"}]
26:["$","p","51",{"className":"mb-6 text-amber-950","children":"\"Ở Vô Tướng Môn, đó không phải chuyện tốt.\""}]
27:["$","p","52",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đứng sững."}]
28:["$","p","53",{"className":"mb-6 text-amber-950","children":"Trong đầu hắn hiện lên căn nhà tranh nhỏ bé ở Thanh Nhai thôn, nơi cha mẹ hắn đêm qua đã không còn nhớ đến hắn."}]
29:["$","p","54",{"className":"mb-6 text-amber-950","children":"Nếu hắn tiếp tục ở đây, lau chùi những cuộn thẻ tre này ngày qua ngày, liệu một ngày nào đó, tên **Tần Vô Thương** cũng sẽ hiện lên trên một cuộn thẻ, rồi bị xóa sạch?"}]
2a:["$","p","55",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói."}]
2b:["$","p","56",{"className":"mb-6 text-amber-950","children":"Đêm đó, hắn nằm trên chiếu rơm, nhìn lên trần nhà đá xám."}]
2c:["$","p","57",{"className":"mb-6 text-amber-950","children":"Cạnh chiếu nằm, dòng chữ **\"Đừng quên\"** vẫn còn đó, như thể có ai đó đã dùng móng tay khắc xuống trong đêm."}]
2d:["$","p","58",{"className":"mb-6 text-amber-950","children":"Hắn thì thầm trong bóng tối:"}]
2e:["$","p","59",{"className":"mb-6 text-amber-950","children":"*\"Ta sẽ không quên.\"*"}]
2f:["$","p","60",{"className":"mb-6 text-amber-950","children":"Giọng hắn rất khẽ."}]
30:["$","p","61",{"className":"mb-6 text-amber-950","children":"*\"Dù thế gian nói nàng chưa từng tồn tại.\"*"}]
31:["$","p","62",{"className":"mb-6 text-amber-950","children":"Ngay khi hắn thì thầm câu đó, từ phía thư viện cổ, một tiếng thét vang lên, như thể hàng vạn linh hồn vừa đồng loạt nhớ ra một cái tên đã bị xóa sạch."}]
32:["$","p","63",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi Tần Vô Thương tỉnh dậy, trên nền đá cạnh chiếu nằm, dòng chữ cũ đã biến mất."}]
33:["$","p","64",{"className":"mb-6 text-amber-950","children":"Thay vào đó, một dòng chữ mới hiện ra, nét chữ run rẩy như thể người viết đang khóc:"}]
34:["$","p","65",{"className":"mb-6 text-amber-950","children":"**\"Tên ta... đã bị xóa rồi sao?\"**"}]
35:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-4","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 4: Kẻ Quét Tên Người"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-6","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 6: Người Đã Quên Tên Mình"}]]}]}]]}]}]}]
36:["$","$L37",null,{"children":["$","$38",null,{"name":"Next.MetadataOutlet","children":"$@39"}]}]
39:null
