0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 3: Người Dưới Tán Ô"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Tiếng nói vang lên lần nữa, nhưng lần này không từ dưới nước."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Mà là từ ngay phía sau lưng hắn."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương quay lại thật nhanh. Bờ vai hắn va vào cành cây khô, lá rụng xào xạc. Trước mắt hắn, bên bờ hồ Vong Xuyên mờ sương, không một bóng người."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Chỉ có gió đêm lùa qua những bụi cỏ dại, mang theo tiếng thở dài của hàng vạn linh hồn vương vãi trên bờ hồ cổ."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"Hắn thở dốc, cổ áo ướt sũng mồ hôi lạnh."}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Bỗng nhiên, hắn thấy ánh sáng."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Không phải ánh đuốc rực rỡ. Là ánh sáng lạnh nhạt từ những viên minh châu treo ở thắt lưng, hắt lên những gương mặt không cảm xúc."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Bên kia bờ hồ, từ khi nào đã có thêm bảy người."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"Họ mặc những bộ đạo bào xám đen, đứng im lìm như những cái cây khô cỗi. Không tiếng bước chân, không một gợn sóng trên mặt nước hồ khi họ xuất hiện."}],["$","p","9",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương nhìn xuống mặt hồ. Nước đen kịt, không một bóng phản chiếu của bảy người kia. Chỉ có bóng hình hắn, lạc lõng và hốc hác."}],["$","p","10",{"className":"mb-6 text-amber-950","children":"\"Ngươi...\" Một lão giả từ trong nhóm bước ra. Râu tóc bạc phơ, đôi mắt già nua nhìn thẳng vào vết sẹo lõm nhỏ ở cổ tay áo hắn. \"Ngươi không có linh căn.\""}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Hắn im lặng."}],["$","p","12",{"className":"mb-6 text-amber-950","children":"\"Nhưng Vong Xuyên lại trả lời ngươi.\" Lão giả lẩm bẩm, giọng khàn đặc như thể vừa nhai sỏi đá. \"Thứ lẽ ra phải chìm sâu dưới đáy hồ từ vạn năm trước... lại dám vọng lên tiếng gọi ngươi.\""}],["$","p","13",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt nắm đấm. Cổ tay hắn nhức nhói, vết sẹo ấy như muốn bùng cháy."}],["$","p","14",{"className":"mb-6 text-amber-950","children":"\"Các hạ là...\""}],["$","p","15",{"className":"mb-6 text-amber-950","children":"\"Vô Tướng Môn.\" Lão giả cắt ngang, không vội vàng. \"Ngươi không cần biết ta là ai. Ngươi chỉ cần biết, từ khi ngươi bước chân đến đây, nơi này đã bắt đầu nhớ về ngươi.\""}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}]}],"$L18"]}],null,"$L19"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"HHZsBH1x4frJs2LPctWw0"}
3:["$","p","16",{"className":"mb-6 text-amber-950","children":"Hắn không hiểu."}]
4:["$","p","17",{"className":"mb-6 text-amber-950","children":"\"Ngươi không có linh căn. Nhưng trong người ngươi có một thứ khiến mặt nước đã chết này cũng phải rung động.\" Lão giả dừng lại, đôi mắt già nua không chớp mắt, như đang nhìn một người đáng lẽ không nên sinh ra. \"Thứ đó... khiến ngươi không thuộc về cái thôn nhỏ này nữa.\""}]
5:["$","p","18",{"className":"mb-6 text-amber-950","children":"\"Ý ngươi là...\""}]
6:["$","p","19",{"className":"mb-6 text-amber-950","children":"\"Đi với lão phu.\" Lão giả không mời mọc, mà là ra lệnh. \"Không phải làm đệ tử. Mà là... tạp dịch. Kẻ quét dọn những gì còn sót lại của sự thật.\""}]
7:["$","p","20",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương lùi lại nửa bước, gót chân vấp phải rễ cây. \"Ta không đi. Cha mẹ ta...\""}]
8:["$","p","21",{"className":"mb-6 text-amber-950","children":"\"Cha mẹ ngươi?\" Lão giả bỗng cười, một nụ cười lạnh lẽo hơn cả mưa đêm. \"Nếu ngươi ở lại đây, trước khi trời sáng, bọn họ sẽ quên sạch tên ngươi. Họ sẽ nhìn ngươi như một kẻ lạ, một tạp chất của đất trời mà họ từng vô tình nhặt về.\""}]
9:["$","p","22",{"className":"mb-6 text-amber-950","children":"Hắn đứng sững."}]
a:["$","p","23",{"className":"mb-6 text-amber-950","children":"\"Đi theo lão phu.\" Lão giả giơ tay áo, một luồng linh khí xám xịt quét qua không trung, không phải để tấn công, mà là để chỉ vào khoảng không sau lưng hắn. \"Nếu không, Vong Xuyên sẽ không chỉ nuốt chửng ký ức của ngươi, mà còn nuốt chửng cả cái tên mà cha mẹ ngươi từng đặt cho ngươi.\""}]
b:["$","p","24",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương quay đầu nhìn lại mặt hồ."}]
c:["$","p","25",{"className":"mb-6 text-amber-950","children":"Nước đen kịt, không một gợn sóng."}]
d:["$","p","26",{"className":"mb-6 text-amber-950","children":"Nhưng dưới đáy sâu, chiếc ô giấy màu đỏ chìm sâu dần, những cánh ô mỏng manh khép lại, như một con bướm đang chết đi để chờ hồi sinh ra ở một kiếp khác."}]
e:["$","p","27",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại."}]
f:["$","p","28",{"className":"mb-6 text-amber-950","children":"\"Vô Thương ca ca...\" Tiếng thì thầm từ dưới đáy nước vọng lên, vang vọng như thể nàng đang nằm ngay dưới chân hắn. \"Sao ca ca lại đứng xa thế? Mau lại đây với ta...\""}]
10:["$","p","29",{"className":"mb-6 text-amber-950","children":"Hắn giật mình lùi lại. Khi mở mắt, bờ vai hắn đã chạm vào lão giả đứng sau lưng."}]
11:["$","p","30",{"className":"mb-6 text-amber-950","children":"\"Quyết định đi.\" Lão giả thì thầm, giọng lão trầm xuống, như đang nói với một người sắp chết. \"Đi theo ta, ngươi sẽ biết vì sao mình sinh ra. Ở lại đây, ngươi sẽ quên sạch sẽ, từ cái tên, đến chiếc ô đỏ, rồi đến cả nàng.\""}]
12:["$","p","31",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương nhìn lại Thanh Nhai thôn, nơi ánh đèn dầu le lói đang rung rinh trong đêm mưa."}]
13:["$","p","32",{"className":"mb-6 text-amber-950","children":"Một sự im lặng đến rợn người bao trùm lấy."}]
14:["$","p","33",{"className":"mb-6 text-amber-950","children":"Hắn bước theo lão giả."}]
15:["$","p","34",{"className":"mb-6 text-amber-950","children":"Không phải vì bị ép. Mà là để giữ lại chút ký ức cuối cùng về chiếc ô màu đỏ, và tiếng gọi \"Vô Thương ca ca\" từ kiếp trước."}]
16:["$","p","35",{"className":"mb-6 text-amber-950","children":"Khi bóng họ khuất sau sương mù, trên mặt hồ Vong Xuyên, chiếc ô đỏ đã hoàn toàn biến mất."}]
17:["$","p","36",{"className":"mb-6 text-amber-950","children":"Chỉ còn lại một cánh hoa anh đào đỏ như máu, chầm chậm trôi ra giữa hồ, rồi chìm nghỉm vào hư không."}]
