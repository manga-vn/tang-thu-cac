d:[["$","title","0",{"children":"Chương 1: Chiếc ô màu đỏ - Vong Xuyên Điệp - Tàng Thư Các"}],["$","meta","1",{"name":"description","content":"Đọc Chương 1: Chiếc ô màu đỏ của truyện Vong Xuyên Điệp trên Tàng Thư Các."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?favicon.0x3dzn~oxb6tn.ico","sizes":"256x256","type":"image/x-icon"}],["$","$L10","3",{}]]
5:["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 1: Chiếc ô màu đỏ"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Trời mưa suốt bảy ngày."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Ở Thanh Nhai thôn, kẻ không có linh căn là tạp chất của đất trời. Linh khí đi qua người Tần Vô Thương như nước chảy qua đá, không vương vấn chút gì. Hắn đứng dưới hiên tranh nứt nẻ, nhìn bàn tay xương xẩu, những ngón tay trắng bệch, gân xanh nổi lên như rễ cây cỗi."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Hắn không cảm nhận được linh khí, nhưng lại cảm thấy... những rung động kỳ lạ trong không khí."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Mỗi khi có người bước qua sân, lồng ngực hắn lại biến đổi. Ông lão làm ruộng đi qua, ngực hắn ấm lên một chút, dễ chịu như thể vừa uống một bát cháo nóng. Một đứa trẻ chạy vụt qua, ngực hắn lại lạnh đi, như thể vừa nhúng tay vào giếng sâu."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"Nhưng khi hắn nhìn chính khuôn mặt hốc hác của mình trong gương, mọi thứ im lặng."}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Một sự im lặng đến rợn người. Như đáy giếng."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Hắn là kẻ cô độc tuyệt đối giữa thế giới đầy rẫy những mối kết nối."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"\"Vô Thương! Vô Thương! Đi rửa rau đây!\""}],["$","p","8",{"className":"mb-6 text-amber-950","children":"Tiếng bà Tư ở đầu thôn gọi. Hắn cầm rổ rá đi ra sông. Dọc đường, những đứa trẻ con nhà kia trông thấy hắn, đều lảng tránh, như thể hắn là vật mang xui xẻo."}],["$","p","9",{"className":"mb-6 text-amber-950","children":"Ở Thanh Nhai thôn, trẻ con có linh căn được đưa lên đường học cách dẫn khí. Còn kẻ không có linh căn như hắn, chỉ xứng làm việc vụn vặt sau mưa: rửa rau, gánh nước, vét bùn trước cửa nhà người khác."}],["$","p","10",{"className":"mb-6 text-amber-950","children":"\"Đấy, phế vật đấy.\" Một đứa nhỏ thì thầm. \"Nghe nói hắn sinh ra hôm đó, trời nứt đôi ở Thanh Nhai, từ đó không thấy tiền đồ.\""}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương không nói gì, bước qua vũng bùn. Hắn đã quen với những lời nói ấy. Năm hắn mười hai tuổi, cũng cái tuổi này, trong nhà từng xảy ra một chuyện chết chóc lúc mưa gió, để lại một vết sẹo không ai dám nhắc lại. Mẹ hắn khi ấy đã nắm chặt tay hắn, móng tay lạnh ngắt như ngâm trong nước giếng sâu, bảo: *\"Thương nhi, sau này nếu con nghe thấy có người gọi tên mình trong mưa... đừng trả lời.\"*"}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d"]}]}],"$L2e"]}]
11:["$","p","12",{"className":"mb-6 text-amber-950","children":"Hắn chưa bao giờ hiểu tại sao."}]
12:["$","p","13",{"className":"mb-6 text-amber-950","children":"Đêm đó, giấc mơ lại đến."}]
13:["$","p","14",{"className":"mb-6 text-amber-950","children":"Không phải những cơn ác mộng thường lệ về việc bị bắt nạt. Là một hình ảnh rất rõ ràng, rực rỡ giữa màn sương mờ."}]
14:["$","p","15",{"className":"mb-6 text-amber-950","children":"Một chiếc ô giấy màu đỏ."}]
15:["$","p","16",{"className":"mb-6 text-amber-950","children":"Một cô bé đứng dưới mưa, nghiêng ô che cho hắn. Khuôn mặt nàng khuất sau lớp vải mỏng, chỉ thấy đôi mắt trong suốt như suối nguồn. Giọng nói trong trẻo vang lên, nghe như chuông ngân giữa cơn mưa rào:\n*\"Vô Thương ca ca, mau vào đây, mưa to lắm.\"*"}]
16:["$","p","17",{"className":"mb-6 text-amber-950","children":"Hắn giật mình tỉnh dậy. Nước mắt hắn rơi trước cả khi ý thức kịp. Tại sao lại khóc? Tại sao câu nói đơn giản ấy lại khiến lồng ngực đau nhói như thể có ai đó đang bóp nghẹt tim hắn?"}]
17:["$","p","18",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, trời vẫn xám xịt. Mưa lất phất như sương."}]
18:["$","p","19",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương lục tung cái rương gỗ cũ kỹ trong góc nhà. Chiếc rương này vốn là đồ cũ của mẹ hắn, nắp gỗ mục nát, mùi mốc meo bốc lên nồng nặc."}]
19:["$","p","20",{"className":"mb-6 text-amber-950","children":"\"Con tìm gì thế?\" Cha hắn từ ngoài sân bước vào, thắc mắc."}]
1a:["$","p","21",{"className":"mb-6 text-amber-950","children":"\"Chiếc ô.\" Hắn đáp, giọng khàn đặc. \"Con mơ thấy một chiếc ô màu đỏ.\""}]
1b:["$","p","22",{"className":"mb-6 text-amber-950","children":"Cha hắn sững người. Bàn tay đang vắt khăn trên vai chợt dừng lại. Chiếc khăn ướt trong tay rơi xuống đất, nước bẩn loang ra như một vệt mực đen. Một thoáng sợ hãi lóe lên trong đôi mắt già nua, rồi nhanh chóng bị dập tắt bởi vẻ mặt nghiêm nghị."}]
1c:["$","p","23",{"className":"mb-6 text-amber-950","children":"\"Nhà mình chưa từng có chiếc ô nào cả.\" Ông lắc đầu, giọng cứng đờ. \"Con mơ mộng quá rồi. Từ nhỏ con đã không thích màu đỏ, hay quên chuyện xưa là phải.\""}]
1d:["$","p","24",{"className":"mb-6 text-amber-950","children":"Mẹ hắn đang quét sân, nghe vậy cũng gật đầu, nhưng tay bà lại làm rơi chiếc bát sứ đang cầm. Bát vỡ tan, mảnh sứ văng vào góc vườn hoang, nơi chiếc quan tài cũ nằm im giữa cỏ dại và rác mục từ mười năm nay."}]
1e:["$","p","25",{"className":"mb-6 text-amber-950","children":"\"Đừng nhắc đến màu đỏ trong nhà này nữa.\" Mẹ hắn thì thầm, giọng run rẩy. \"Từ hôm đó... từ cái mưa mười năm trước, đừng nhắc nữa.\""}]
1f:["$","p","26",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương im lặng. Hắn bước ra sân, nhìn về phía chiếc quan tài gỗ mục ở góc vườn. Đó là một chiếc quan tài kỳ lạ. Mười năm trước, sau trận mưa lớn nhất thế kỷ, nó tự nhiên xuất hiện ở đó. Cha hắn đã dùng rìu đánh, dùng cưa cắt, nhưng nắp gỗ cứng như đá, không một vết xước. Từ đó, nó bị bỏ hoang, trở thành thứ bị nước mưa, bùn đất và rác mục vùi lấp qua năm tháng."}]
20:["$","p","27",{"className":"mb-6 text-amber-950","children":"Hắn bước tới gần. Bàn tay lướt qua lớp vải rách nát của chiếc áo cũ. Ở cổ tay áo, có một vết tích như thể từng có một sợi chỉ đỏ bị nhổ đi, để lại vết sẹo lõm nhỏ xíu, giống hệt như nỗi đau trong lồng ngực."}]
21:["$","p","28",{"className":"mb-6 text-amber-950","children":"*\"Ta sẽ nhớ.\"* - Hắn thầm thì trong mưa, giọng nghẹn lại. *\"Dù các người có nói gì, dù nhà mình chưa từng có, ta vẫn sẽ nhớ.\"*"}]
22:["$","p","29",{"className":"mb-6 text-amber-950","children":"Hắn nhìn vào trong quan tài qua khe hở. Không phải xác chết. Chỉ là một khoảng không tối đen, nhưng mỗi khi hắn nhìn vào, lồng ngực hắn lại ấm lên một cách kỳ lạ, rồi lại lạnh đi nhanh chóng."}]
23:["$","p","30",{"className":"mb-6 text-amber-950","children":"Đó là lúc hắn nghe thấy tiếng gõ."}]
24:["$","p","31",{"className":"mb-6 text-amber-950","children":"*Cộc. Cộc. Cộc.*"}]
25:["$","p","32",{"className":"mb-6 text-amber-950","children":"Tiếng gõ rất nhẹ, giống như một người yếu ớt đang dùng đầu ngón tay chạm lên nắp gỗ. Không phải từ trong nhà. Không phải từ hàng xóm. Mà là từ chiếc quan tài ấy."}]
26:["$","p","33",{"className":"mb-6 text-amber-950","children":"Hắn sờ lên nắp quan tài. Gỗ lạnh toát, nhưng có chỗ cảm giác như da người. Từ khe hở, một hơi lạnh lan tỏa, không phải sợ hãi, mà là một nỗi nhớ nhung không tên."}]
27:["$","p","34",{"className":"mb-6 text-amber-950","children":"Tiếng nói vang lên từ bên trong, vang vọng như từ một thời đại khác vọng lại:"}]
28:["$","p","35",{"className":"mb-6 text-amber-950","children":"*\"Còn nhớ hoa anh đào không?\"*"}]
29:["$","p","36",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương quỵ xuống bùn. Hắn không khóc. Hắn chỉ nhìn vào khoảng không, nơi một cảm giác mơ hồ vừa bị rút đi khỏi lồng ngực. Không phải máu. Không phải hơi thở. Là một phần ký ức mà hắn thậm chí còn chưa kịp gọi tên."}]
2a:["$","p","37",{"className":"mb-6 text-amber-950","children":"Trời vẫn mưa. Nhưng tiếng mưa đã biến mất."}]
2b:["$","p","38",{"className":"mb-6 text-amber-950","children":"Chỉ còn tiếng thở dài của hàng vạn linh hồn dưới lòng đất, đang chờ đợi một người con trai nhớ lại điều cả thế gian đều muốn quên."}]
2c:["$","p","39",{"className":"mb-6 text-amber-950","children":"Khi hắn ngẩng đầu lên lần nữa, trên nắp quan tài ướt sũng, hắn thấy một vết khắc rất mảnh, như thể vừa mới hình thành:"}]
2d:["$","p","40",{"className":"mb-6 text-amber-950","children":"Một cánh hoa anh đào đỏ như máu."}]
