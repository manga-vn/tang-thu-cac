d:[["$","title","0",{"children":"Chương 4: Kẻ Quét Tên Người - Vong Xuyên Điệp - Tàng Thư Các"}],["$","meta","1",{"name":"description","content":"Đọc Chương 4: Kẻ Quét Tên Người của truyện Vong Xuyên Điệp trên Tàng Thư Các."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?favicon.0x3dzn~oxb6tn.ico","sizes":"256x256","type":"image/x-icon"}],["$","$L10","3",{}]]
5:["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 4: Kẻ Quét Tên Người"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Bảy người áo xám đi trước, bước chân không hề để lại dấu vết trên lớp bùn đất sau mưa."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đi sau cùng, đôi chân gầy guộc lấm lem bùn đất, mỗi bước đi đều khiến lồng ngực hắn căng lên, như có thứ gì rất mảnh đang bị kéo khỏi Thanh Nhai thôn. Hắn ngoái lại lần cuối, thấy ánh đèn dầu le lói ở căn nhà tranh nhỏ bé kia chợt tắt ngấm, như thể có ai vừa thổi tắt phần cuối cùng còn nối hắn với nhân gian."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Không một tiếng gọi tên. Không một bóng người đứng ngóng."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Hắn quay đầu, bước tiếp."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"---"}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Sau lưng hắn, trong căn nhà tranh kia, cha hắn bỗng mở mắt."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Ông ngồi dậy rất lâu, nhìn chiếc chiếu trống ở góc phòng, cau mày như đang cố nhớ điều gì."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"\"Mình... có để thứ gì ở đó sao?\" ông hỏi."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"Mẹ hắn cũng tỉnh dậy. Bà nhìn về phía góc phòng ấy, đôi mắt mờ đục. Một lúc lâu sau, bà lắc đầu."}],["$","p","9",{"className":"mb-6 text-amber-950","children":"\"Chắc là gió thổi lạnh thôi.\""}],["$","p","10",{"className":"mb-6 text-amber-950","children":"Rồi bà kéo chăn nằm xuống."}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Không ai nhắc đến Tần Vô Thương."}],["$","p","12",{"className":"mb-6 text-amber-950","children":"---"}],["$","p","13",{"className":"mb-6 text-amber-950","children":"Đường lên núi không dài."}],["$","p","14",{"className":"mb-6 text-amber-950","children":"Nhưng mỗi bước đi, Tần Vô Thương đều cảm thấy mình đang cách Thanh Nhai thôn xa thêm một đời."}],["$","p","15",{"className":"mb-6 text-amber-950","children":"Mây mù dày đặc che khuất đỉnh núi, những cây cổ thụ hai người ôm không một cành lá xanh, chỉ còn những cành khô như xương người vươn lên trời xám. Không tiếng chim hót, không tiếng côn trùng, chỉ có tiếng gió rít qua khe đá như tiếng khóc của vạn linh hồn bị bỏ quên."}],["$","p","16",{"className":"mb-6 text-amber-950","children":"Lão giả dẫn đầu bỗng dừng lại."}],["$","p","17",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cũng dừng theo, hơi thở dồn dập. Trước mặt họ, bên vệ đường đầy lá khô mục, có một người đàn ông đang quét lá."}],["$","p","18",{"className":"mb-6 text-amber-950","children":"Không, không phải quét. Hắn đang gom những chiếc lá khô vào một cái giỏ tre, đôi tay chai sần, những ngón tay dài gầy, cong queo như cành cây khô. Người này mặc một bộ đạo bào rách nát, tóc bạc trắng từ chân tóc, dù khuôn mặt nhìn không già hơn ba mươi."}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42"]}]}],"$L43"]}]
11:["$","p","19",{"className":"mb-6 text-amber-950","children":"Rất lâu về sau, Tần Vô Thương mới biết người đàn ông quét lá ấy tên là **Mạc Trường Phong**."}]
12:["$","p","20",{"className":"mb-6 text-amber-950","children":"Hắn không ngẩng đầu lên khi bọn họ đi qua. Chỉ có đôi mắt u uẩn, nằm sâu trong hốc mắt, khẽ liếc nhìn Tần Vô Thương một cái, rồi lại cúi xuống công việc của mình."}]
13:["$","p","21",{"className":"mb-6 text-amber-950","children":"Lão giả áo xám cũng không nói gì với hắn, chỉ khẽ gật đầu, như một thói quen không cần lời."}]
14:["$","p","22",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cảm thấy một sự lạnh toát tỏa ra từ người đàn ông đang quét lá kia. Không phải linh khí. Mà là một nỗi buồn thảm, sâu thẳm đến mức lồng ngực hắn cũng bắt đầu nhức nhối theo."}]
15:["$","p","23",{"className":"mb-6 text-amber-950","children":"Hắn vội vàng bước qua, không dám ngoái lại."}]
16:["$","p","24",{"className":"mb-6 text-amber-950","children":"---"}]
17:["$","p","25",{"className":"mb-6 text-amber-950","children":"Khi họ lên đến đỉnh núi, cổng lớn của Vô Tướng Môn hiện ra sau lớp sương mù."}]
18:["$","p","26",{"className":"mb-6 text-amber-950","children":"Không khắc chữ. Không tượng thần. Chỉ có một cánh cổng đá xám xịt, đứng sừng sững giữa mây mù, như một lưỡi dao cắt đôi bầu trời. Qua khỏi cổng, không gian bỗng tối sầm lại, dù trời vẫn chưa sáng hẳn."}]
19:["$","p","27",{"className":"mb-6 text-amber-950","children":"Bên trong, những dãy hành lang dài hun hút, hai bên là những tòa nhà đá xám không cửa sổ. Những đạo bào xám đen đi lại không tiếng động, như những bóng ma giữa chốn hoang tàn."}]
1a:["$","p","28",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói. Hắn cảm thấy ở đây, ngay cả không khí cũng đặc quánh lại, như thể hàng vạn linh hồn đang thì thầm trong từng hơi thở."}]
1b:["$","p","29",{"className":"mb-6 text-amber-950","children":"Lão giả dẫn hắn đến một gian phòng nhỏ khuất sau dãy nhà chính. Cửa phòng không có khóa, chỉ có một tấm mành tre sờn rách."}]
1c:["$","p","30",{"className":"mb-6 text-amber-950","children":"\"Từ nay, ngươi ở đây.\" Lão giả quay đi, giọng khàn đặc vang lên lần cuối: \"Sáng mai, ra sau sơn môn. Sẽ có người đưa ngươi việc cần làm.\""}]
1d:["$","p","31",{"className":"mb-6 text-amber-950","children":"Hắn bước vào."}]
1e:["$","p","32",{"className":"mb-6 text-amber-950","children":"Phòng trống trơn, chỉ có một chiếu rơm cứng đờ trải trên nền đá lạnh, một chiếc bát sứ nứt mẻ, và một bình nước bằng đất nung. Không có lò sưởi, không có đèn dầu. Chỉ có ánh sáng xám xịt từ bên ngoài hắt qua khe cửa."}]
1f:["$","p","33",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương ngồi bệt xuống chiếu, đôi bàn tay gầy guộc run rẩy. Hắn nhìn xuống cổ tay áo, vết sẹo lõm nhỏ như muốn nổ tung."}]
20:["$","p","34",{"className":"mb-6 text-amber-950","children":"Hắn không khóc. Chỉ có một nỗi trống rỗng ngột ngạt đang dâng lên trong lồng ngực."}]
21:["$","p","35",{"className":"mb-6 text-amber-950","children":"---"}]
22:["$","p","36",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi màn sương còn chưa tan, Tần Vô Thương đã bị đánh thức bởi một tiếng gõ cửa nhẹ tênh."}]
23:["$","p","37",{"className":"mb-6 text-amber-950","children":"Một đứa trẻ chừng mười tuổi đứng ngoài hiên, mặc một bộ đạo bào xám rách nát hơn cả của hắn. Nó đưa cho hắn một cây chổi tre, cán đã mòn nhẵn, và một cái giỏ mây thủng đáy."}]
24:["$","p","38",{"className":"mb-6 text-amber-950","children":"\"Ngươi là tạp dịch mới?\" Đứa trẻ hỏi, giọng không cảm xúc. \"Ta là Tiểu Thất. Theo ta.\""}]
25:["$","p","39",{"className":"mb-6 text-amber-950","children":"Hắn theo nó ra sau sơn môn, nơi có một cái ao nhỏ nước đen ngòm như mực, mặt ao lặng đến mức không phản chiếu bầu trời. Bên cạnh ao là một tòa thư viện cổ, mái ngói rêu phong, những bức tường đá xám xịt đứng sừng sững giữa mây mù."}]
26:["$","p","40",{"className":"mb-6 text-amber-950","children":"\"Việc của ngươi,\" Tiểu Thất chỉ vào những cuộn thẻ tre chất đống như núi ở hiên thư viện, \"là lau chùi những cuộn thẻ này mỗi ngày. Không được mở ra xem. Chỉ được lau bụi.\""}]
27:["$","p","41",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương nhìn những cuộn thẻ tre kia. Chúng không giống bất cứ thứ gì hắn từng thấy. Bề mặt thẻ tre xám xịt, không khắc chữ, nhưng lại tỏa ra một cảm giác lạnh toát, như thể mỗi cuộn đều chứa đựng một bí mật kinh khủng."}]
28:["$","p","42",{"className":"mb-6 text-amber-950","children":"\"Những cuộn này là...\""}]
29:["$","p","43",{"className":"mb-6 text-amber-950","children":"\"Đừng hỏi.\" Tiểu Thất cắt ngang, đôi mắt đen láy không chớp mắt nhìn hắn. \"Ngươi không có linh căn, nhưng ngươi lại có thứ khiến bọn họ sợ hãi. Ở đây, kẻ không có linh căn như chúng ta chỉ có một việc: **quét dọn những gì còn sót lại của sự thật.**\""}]
2a:["$","p","44",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương nhìn nó rất lâu, bỗng cảm thấy kỳ lạ."}]
2b:["$","p","45",{"className":"mb-6 text-amber-950","children":"Đứa trẻ này rõ ràng đứng trước mặt hắn, nhưng cảm giác trong lồng ngực hắn lại hoàn toàn im lặng. Giống như Tiểu Thất chưa từng có duyên với bất kỳ ai."}]
2c:["$","p","46",{"className":"mb-6 text-amber-950","children":"Nó quay đi, bóng hình nhỏ bé khuất sau màn sương."}]
2d:["$","p","47",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cầm cây chổi tre, đứng giữa sân thư viện. Gió thổi qua, những cuộn thẻ tre kêu lên những tiếng lạo xạo kỳ lạ, như tiếng thì thầm của hàng vạn người đang cố gắng gọi tên ai đó."}]
2e:["$","p","48",{"className":"mb-6 text-amber-950","children":"Hắn bắt đầu lau chùi."}]
2f:["$","p","49",{"className":"mb-6 text-amber-950","children":"Mỗi khi bàn tay hắn chạm vào bề mặt thẻ tre, một cảm giác nhói đau chạy dọc cổ tay, vết sẹo lõm nhỏ như muốn bùng cháy. Hắn cảm thấy những ký ức không phải của mình đang cố gắng chui vào đầu, những mảnh hình vụn vỡ về một cô bé đứng dưới tán ô đỏ..."}]
30:["$","p","50",{"className":"mb-6 text-amber-950","children":"Hắn lắc mạnh đầu, đẩy những hình ảnh đó ra ngoài."}]
31:["$","p","51",{"className":"mb-6 text-amber-950","children":"Chiều tà, khi hắn làm xong việc, Tiểu Thất xuất hiện lần nữa. Nó đưa cho hắn một bát cháo loãng, vài hạt gạo chìm dưới đáy như những hạt cát trắng."}]
32:["$","p","52",{"className":"mb-6 text-amber-950","children":"\"Ăn đi.\" Nó nói, giọng khô khốc. \"Rồi tối nay, ngươi sẽ biết vì sao mình ở đây.\""}]
33:["$","p","53",{"className":"mb-6 text-amber-950","children":"---"}]
34:["$","p","54",{"className":"mb-6 text-amber-950","children":"Đêm đó, Tần Vô Thương nằm trên chiếu rơm cứng đờ, nhìn qua khe cửa sổ nhỏ bé."}]
35:["$","p","55",{"className":"mb-6 text-amber-950","children":"Bên ngoài, ánh trăng tàn khuất sau đám mây dày đặc. Sân thư viện vắng ngắt, chỉ có những cuộn thẻ tre chất đống như những ngôi mộ cổ."}]
36:["$","p","56",{"className":"mb-6 text-amber-950","children":"Bỗng nhiên, hắn thấy một bóng hình."}]
37:["$","p","57",{"className":"mb-6 text-amber-950","children":"Không phải Tiểu Thất. Cũng không phải Mạc Trường Phong."}]
38:["$","p","58",{"className":"mb-6 text-amber-950","children":"Mà là một cô bé, đứng dưới gốc cây khô bên bờ ao, đôi mắt trong suốt như suối nguồn nhìn thẳng về phía hắn. Nàng mặc một chiếc váy đỏ thẫm, trong tay cầm một chiếc ô giấy màu đỏ, những cánh ô khép lại, như một con bướm đang ngủ đông."}]
39:["$","p","59",{"className":"mb-6 text-amber-950","children":"Hắn giật mình ngồi dậy."}]
3a:["$","p","60",{"className":"mb-6 text-amber-950","children":"Khi hắn nhìn lại, bóng hình đó đã biến mất."}]
3b:["$","p","61",{"className":"mb-6 text-amber-950","children":"Chỉ còn lại một cánh hoa anh đào đỏ như máu, nằm lặng lẽ trên bậu cửa sổ."}]
3c:["$","p","62",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cầm lấy cánh hoa, ngón tay chạm vào cánh hoa mỏng manh, một cảm giác ấm áp chợt lấp đầy lồng ngực hắn, rồi nhanh chóng lạnh đi."}]
3d:["$","p","63",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại, thì thầm trong đêm tối:"}]
3e:["$","p","64",{"className":"mb-6 text-amber-950","children":"*\"Ta sẽ nhớ. Dù ai có nói gì, dù có phải quên cả tên mình, ta vẫn sẽ nhớ...\"*"}]
3f:["$","p","65",{"className":"mb-6 text-amber-950","children":"Ngay lúc đó, từ phía thư viện cổ, một tiếng thở dài vang lên, như thể hàng vạn linh hồn vừa thì thầm tên hắn một lượt."}]
40:["$","p","66",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi Tần Vô Thương tỉnh dậy, cánh hoa anh đào trên bậu cửa đã biến mất."}]
41:["$","p","67",{"className":"mb-6 text-amber-950","children":"Thay vào đó, trên nền đá cạnh chiếu nằm, có một dòng chữ nhỏ xíu, như thể có ai đã dùng móng tay khắc xuống trong đêm:"}]
42:["$","p","68",{"className":"mb-6 text-amber-950","children":"**\"Đừng quên.\"**"}]
43:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-3","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 3: Người Dưới Tán Ô"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-5","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 5: Thẻ Tre Không Tên"}]]}]}]]}]}]}]
