0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 7: Đừng Nhớ Ta Nữa"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương quyết định không nhớ."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Hắn nhìn vào bức tường đá xám trước mặt, cố gắng không nghĩ về đôi mắt trong suốt như suối nguồn. Cố gắng không nghĩ về giọng nói trong trẻo: *\"Vô Thương ca ca, mau vào đây, mưa to lắm...\"* Cố gắng không nghĩ về chiếc ô giấy màu đỏ."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Nhưng càng cố không nhớ, những chi tiết ấy lại càng hiện rõ."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Mỗi sáng khi lau chùi thẻ tre, hắn nhìn thấy máu từ vết sẹo cổ tay rỉ ra, và bề mặt tre lại hiện lên hình ảnh một cô bé đứng dưới mưa. Hắn vội vàng lau sạch, nhưng hình ảnh đó đã in sâu vào mí mắt."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"Mỗi khi gió thổi qua sân thư viện, tiếng lá khô xào xạc lại nghe như tiếng cô bé gọi tên hắn."}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Mỗi khi nhìn thấy bóng mình trong nước ao đen ngòm, hắn lại thấy sau lưng mình có một bóng hình nhỏ bé, mờ ảo như sương mai."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Hắn biết, hắn đang cố không nhớ nàng."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Nhưng cả thế gian đang giúp hắn nhớ."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"---"}],["$","p","9",{"className":"mb-6 text-amber-950","children":"Một buổi chiều tà, khi Tần Vô Thương đang quét lá khô trước hiên thư viện, một bóng người xuất hiện từ trong màn sương."}],["$","p","10",{"className":"mb-6 text-amber-950","children":"Không phải Tiểu Thất. Cũng không phải lão giả râu tóc bạc phơ."}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Mà là **Mạc Trường Phong**."}],["$","p","12",{"className":"mb-6 text-amber-950","children":"Người đàn ông vẫn mặc bộ đạo bào rách nát, tóc bạc trắng từ chân tóc, những ngón tay dài gầy, cong queo như cành cây khô. Hắn vẫn đang cầm cây chổi tre, nhưng không quét lá, mà chỉ đứng nhìn Tần Vô Thương, đôi mắt u uẩn nằm sâu trong hốc mắt."}],["$","p","13",{"className":"mb-6 text-amber-950","children":"Lần đầu tiên, Mạc Trường Phong lên tiếng."}],["$","p","14",{"className":"mb-6 text-amber-950","children":"\"Ngươi quét chậm quá.\""}],["$","p","15",{"className":"mb-6 text-amber-950","children":"Giọng nói khàn đặc, như thể vừa nhai sỏi đá, nhưng lại có một sự mệt mỏi vô biên, như thể người này đã quá mệt mỏi với việc tồn tại."}],["$","p","16",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương dừng tay, nhìn thẳng vào đôi mắt u uẩn ấy. \"Ngươi... là ai?\""}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d"]}]}],"$L3e"]}],null,"$L3f"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"HHZsBH1x4frJs2LPctWw0"}
3:["$","p","17",{"className":"mb-6 text-amber-950","children":"\"Mạc Trường Phong.\" Hắn đáp, giọng không cảm xúc. \"Nhưng ở đây, tên không quan trọng. Tên là thứ dễ mất nhất.\""}]
4:["$","p","18",{"className":"mb-6 text-amber-950","children":"Hắn nhìn cây chổi trong tay mình."}]
5:["$","p","19",{"className":"mb-6 text-amber-950","children":"\"Nếu muốn, ngươi có thể gọi ta là kẻ quét lá.\""}]
6:["$","p","20",{"className":"mb-6 text-amber-950","children":"Hắn im lặng một lát, rồi bỗng hỏi: \"Tại sao ngươi lại nói với ta?\""}]
7:["$","p","21",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong nhìn thẳng vào vết sẹo lõm nhỏ ở cổ tay áo hắn. \"Vì ngươi là kẻ duy nhất ở đây nhớ một người đã bị xóa tên.\""}]
8:["$","p","22",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt nắm đấm. \"Ngươi biết nàng?\""}]
9:["$","p","23",{"className":"mb-6 text-amber-950","children":"\"Ta không biết tất cả.\" Mạc Trường Phong đáp, giọng trầm xuống như thể đang nói với một người sắp chết. \"Nhưng ta đã quét qua đủ nhiều cái tên để biết: người còn được nhớ thường đau hơn người đã quên.\""}]
a:["$","p","24",{"className":"mb-6 text-amber-950","children":"\"Nàng...\" Tần Vô Thương nghẹn ngào. \"Nàng tên là gì?\""}]
b:["$","p","25",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong lắc đầu. \"Ta không được phép nói. Chỉ có kẻ không có linh căn mới nhìn thấy được cái tên đó. Và chỉ có kẻ dám gọi tên đó mới biết được sự thật.\""}]
c:["$","p","26",{"className":"mb-6 text-amber-950","children":"\"Ở Vô Tướng Môn, người nhớ nhiều nhất thường chết sớm nhất.\""}]
d:["$","p","27",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đứng sững."}]
e:["$","p","28",{"className":"mb-6 text-amber-950","children":"\"Ngươi đang nhớ nàng.\" Mạc Trường Phong tiếp tục, giọng không chút dao động. \"Mỗi lần ngươi nhớ, Vong Xuyên lại cảm nhận được sự tồn tại của nàng. Và mỗi lần Vong Xuyên cảm nhận được, nó lại kéo nàng xuống sâu hơn.\""}]
f:["$","p","29",{"className":"mb-6 text-amber-950","children":"\"Ta không thể quên nàng.\""}]
10:["$","p","30",{"className":"mb-6 text-amber-950","children":"\"Thì ngươi sẽ chết sớm.\" Mạc Trường Phong cắt ngang, giọng lạnh lẽo hơn cả mưa đêm. \"Và khi ngươi chết, nàng sẽ hoàn toàn biến mất. Không còn ai nhớ nàng. Không còn ai gọi tên nàng. Nàng sẽ chìm sâu vào Vong Xuyên, mãi mãi không được đầu thai, không được siêu thoát.\""}]
11:["$","p","31",{"className":"mb-6 text-amber-950","children":"Hắn quay đi, bóng hình gầy gò khuất vào màn sương, chỉ còn lại tiếng chổi tre quét trên nền đá vang vọng:"}]
12:["$","p","32",{"className":"mb-6 text-amber-950","children":"\"Ở Vô Tướng Môn, kẻ sống sót không phải là kẻ mạnh nhất. Mà là kẻ quên nhanh nhất.\""}]
13:["$","p","33",{"className":"mb-6 text-amber-950","children":"---"}]
14:["$","p","34",{"className":"mb-6 text-amber-950","children":"Đêm đó, Tần Vô Thương nằm trên chiếu rơm, nhìn lên trần nhà đá xám."}]
15:["$","p","35",{"className":"mb-6 text-amber-950","children":"Hắn cố gắng không nhớ nàng."}]
16:["$","p","36",{"className":"mb-6 text-amber-950","children":"Nhưng trong đầu hắn, hình ảnh chiếc ô đỏ lại hiện ra rõ mồn một. Những cánh ô mỏng manh như cánh bướm, khép lại, như một con bướm đang chết đi để chờ hồi sinh ra ở một kiếp khác."}]
17:["$","p","37",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại, cố đẩy hình ảnh đó ra ngoài."}]
18:["$","p","38",{"className":"mb-6 text-amber-950","children":"Nhưng từ cổ tay, vết sẹo lõm nhỏ lại nhức nhói, như thể đang nhắc nhở hắn: *\"Ngươi không thể quên. Vì nếu ngươi quên, nàng sẽ hoàn toàn biến mất.\"*"}]
19:["$","p","39",{"className":"mb-6 text-amber-950","children":"Hắn biết Mạc Trường Phong nói đúng."}]
1a:["$","p","40",{"className":"mb-6 text-amber-950","children":"Nếu hắn nhớ nàng, Vong Xuyên sẽ kéo nàng xuống sâu hơn."}]
1b:["$","p","41",{"className":"mb-6 text-amber-950","children":"Nhưng nếu hắn quên nàng, nàng sẽ biến mất mãi mãi."}]
1c:["$","p","42",{"className":"mb-6 text-amber-950","children":"Lựa chọn nào cũng đau."}]
1d:["$","p","43",{"className":"mb-6 text-amber-950","children":"Con đường nào cũng là ngõ cụt."}]
1e:["$","p","44",{"className":"mb-6 text-amber-950","children":"---"}]
1f:["$","p","45",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi Tần Vô Thương tỉnh dậy, trên nền đá cạnh chiếu nằm, dòng chữ cũ đã biến mất."}]
20:["$","p","46",{"className":"mb-6 text-amber-950","children":"Thay vào đó, một dòng chữ mới hiện ra, nét chữ run rẩy như thể người viết đang khóc, nhưng lần này có thêm một chi tiết khiến hắn tim đập thình thịch:"}]
21:["$","p","47",{"className":"mb-6 text-amber-950","children":"**\"Đừng nhớ ta nữa. Không phải để bảo vệ ngươi.**  \n**Mà là để ngăn ngươi kéo ta tỉnh dậy quá sớm.\"**"}]
22:["$","p","48",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương chết lặng."}]
23:["$","p","49",{"className":"mb-6 text-amber-950","children":"Hắn nhìn dòng chữ rất lâu."}]
24:["$","p","50",{"className":"mb-6 text-amber-950","children":"Hắn bỗng hiểu."}]
25:["$","p","51",{"className":"mb-6 text-amber-950","children":"Nàng không chỉ sợ hắn bị Vong Xuyên kéo xuống."}]
26:["$","p","52",{"className":"mb-6 text-amber-950","children":"Nàng sợ chính mình tỉnh lại quá sớm."}]
27:["$","p","53",{"className":"mb-6 text-amber-950","children":"Trần Đại Thụ chỉ vì được gọi tên một lần đã đau đến mức quên sạch lần nữa. Nếu nàng cũng tỉnh dậy khi hắn còn chưa đủ sức giữ lấy nàng, kết cục của nàng có lẽ cũng sẽ như vậy."}]
28:["$","p","54",{"className":"mb-6 text-amber-950","children":"Hoặc tệ hơn."}]
29:["$","p","55",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói."}]
2a:["$","p","56",{"className":"mb-6 text-amber-950","children":"Hắn sẽ không quên nàng."}]
2b:["$","p","57",{"className":"mb-6 text-amber-950","children":"Nhưng hắn sẽ không để nàng tỉnh dậy quá sớm."}]
2c:["$","p","58",{"className":"mb-6 text-amber-950","children":"Hắn sẽ chờ. Chờ đến khi hắn đủ mạnh để đối đầu với Vong Xuyên."}]
2d:["$","p","59",{"className":"mb-6 text-amber-950","children":"Chờ đến khi hắn có thể cứu nàng."}]
2e:["$","p","60",{"className":"mb-6 text-amber-950","children":"---"}]
2f:["$","p","61",{"className":"mb-6 text-amber-950","children":"Đêm đó, lần đầu tiên sau nhiều ngày, Tần Vô Thương nhắm mắt lại và không thấy hình ảnh nàng dưới tán ô đỏ."}]
30:["$","p","62",{"className":"mb-6 text-amber-950","children":"Hắn chỉ thấy một cánh đồng hoa anh đào đỏ rực."}]
31:["$","p","63",{"className":"mb-6 text-amber-950","children":"Giữa cánh đồng có một chiếc ô giấy màu đỏ đang mở."}]
32:["$","p","64",{"className":"mb-6 text-amber-950","children":"Dưới tán ô không có ai."}]
33:["$","p","65",{"className":"mb-6 text-amber-950","children":"Nhưng mặt đất bên dưới lại ướt đẫm, như thể vừa có một người đứng đó rất lâu, rồi bị mưa xóa mất."}]
34:["$","p","66",{"className":"mb-6 text-amber-950","children":"Hắn không đáp."}]
35:["$","p","67",{"className":"mb-6 text-amber-950","children":"Chỉ có một nỗi đau nhói ở cổ tay, và một lời thề không thành lời:"}]
36:["$","p","68",{"className":"mb-6 text-amber-950","children":"*Chờ ta. Dù có phải đối đầu với cả Vong Xuyên, ta cũng sẽ cứu nàng.*"}]
37:["$","p","69",{"className":"mb-6 text-amber-950","children":"---"}]
38:["$","p","70",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, trên nền đá, dòng chữ đã biến mất."}]
39:["$","p","71",{"className":"mb-6 text-amber-950","children":"Chỉ còn lại một cánh hoa anh đào đỏ như máu, nằm lặng lẽ trên nền đá lạnh."}]
3a:["$","p","72",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cầm lấy cánh hoa, ngón tay chạm vào cánh hoa mỏng manh, đầu ngón tay lại đau như chạm vào một vết thương cũ."}]
3b:["$","p","73",{"className":"mb-6 text-amber-950","children":"Hắn biết, từ nay về sau, hắn sẽ không còn cố gắng quên nàng."}]
3c:["$","p","74",{"className":"mb-6 text-amber-950","children":"Nhưng hắn sẽ học cách nhớ nàng mà không kéo nàng tỉnh dậy."}]
3d:["$","p","75",{"className":"mb-6 text-amber-950","children":"Hắn sẽ học cách... **tồn tại cùng nỗi đau.**"}]
3e:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-6","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 6: Người Đã Quên Tên Mình"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-8","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 8: Tên Là Thứ Dễ Mất Nhất"}]]}]}]]}]}]}]
