d:[["$","title","0",{"children":"Chương 11: Dịch Chuyển Trong Mưa - Vong Xuyên Điệp - Tàng Thư Các"}],["$","meta","1",{"name":"description","content":"Đọc Chương 11: Dịch Chuyển Trong Mưa của truyện Vong Xuyên Điệp trên Tàng Thư Các."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?favicon.0x3dzn~oxb6tn.ico","sizes":"256x256","type":"image/x-icon"}],["$","$L10","3",{}]]
5:["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 11: Dịch Chuyển Trong Mưa"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Tiếng chuông trấn môn vang lên ba hồi, âm thanh ấy không lớn nhưng lại như một lưỡi dao cùn kéo qua màn sương đỏ ửng của hoàng hôn, khiến toàn bộ Vô Tướng Môn chợt im phăng phắc trong thoáng chốc rồi ngay sau đó cả môn phái chuyển động, những đệ tử mặc đạo bào xanh vội vã lướt qua hành lang đá, tiếng bước chân, tiếng pháp khí va vào nhau, tiếng linh thú gầm khẽ từ chuồng sâu phía bắc hòa vào cơn mưa rỉ rả như tiếng một cỗ máy cổ xưa đang thức dậy."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đứng dưới hiên thư viện, đôi mắt đen láy nhìn về phía tháp chuông, nơi sợi chỉ đỏ ở cổ tay áo đang rung lên từng chút một, không phải rung vì sợ hãi, mà là một cảm giác xa lạ, như thể có ai đó vừa chạm vào ký ức của hắn, nhẹ nhàng nhưng để lại một vết lạnh buốt."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"\"Ngươi cảm thấy chưa?\" Tiểu Thất xuất hiện từ màn sương, đôi mắt đen láy không chớp mắt nhìn sợi chỉ đỏ đang căng trên cổ tay hắn. \"Sợi chỉ đỏ của ngươi... nó đang dài ra.\""}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt nắm đấm, vết sẹo lõm nhỏ ở cổ tay lại nhức nhói. Hắn cảm thấy máu đang rỉ ra từng giọt, nhưng không nhỏ xuống nền đá, mà thấm ngược vào sợi chỉ đỏ, khiến nó sáng lên mỗi lúc một rực rỡ, đỏ thẫm như hồng ngọc dưới ánh hoàng hôn tàn."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"\"Mỗi giọt máu...\" Tiểu Thất thì thầm, giọng nhẹ đến mức như thể sợ những bức tường đá cũng nghe thấy. \"Là một mảnh ký ức ngươi sắp mất đi.\""}],["$","p","5",{"className":"mb-6 text-amber-950","children":"---"}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Đêm đó, mưa tại Vô Tướng Môn không còn rơi rỉ rả nữa mà bắt đầu trút xuống xối xả, từng hạt nước đập vào mái ngói cổ tạo nên một bản giao hưởng u ám, lạnh lẽo, thấm sâu vào da thịt những kẻ đang quét dọn sự thật ở nơi này. Tần Vô Thương ngồi trên chiếu rơm cứng đờ, nhìn vào sợi chỉ đỏ đang căng cứng giữa không trung, nó không còn rung rinh nữa mà đứng sừng sững như một mũi kim cắm vào thực tại, nối vết sẹo ở cổ tay hắn với một khoảng không xa xăm ở phía bên kia thế giới."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Hắn nhắm mắt lại, để ký ức dẫn lối."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"Không phải lần này qua Vong Xuyên Đàm, mà là một hành lang dài hun hút, hai bên là những bức tường đá xám xịt, những ngọn đuốc lạnh lẽo cháy xanh rực, chiếu sáng những cánh cửa gỗ mục nát, trên mỗi cánh cửa đều khắc một cái tên đã bị xóa sạch khỏi thế gian."}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}]}],"$L2c"]}]
11:["$","p","9",{"className":"mb-6 text-amber-950","children":"Sợi chỉ đỏ kéo mạnh."}]
12:["$","p","10",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cảm thấy thân hình mình bỗng nhẹ tênh, như thể linh hồn vừa tách khỏi xác thịt, trôi dạt trong một không gian không thuộc về dương gian cũng chẳng phải âm phủ, chỉ là một khoảng không trắng xóa, lạnh toát, nơi những sợi chỉ vô hình đang đan xen vào nhau tạo thành một mạng lưới khổng lồ bao phủ toàn bộ nhân gian."}]
13:["$","p","11",{"className":"mb-6 text-amber-950","children":"Rồi hắn thấy nàng."}]
14:["$","p","12",{"className":"mb-6 text-amber-950","children":"Không phải dưới tán ô đỏ. Mà là đang đứng giữa một cánh đồng hoa anh đào rực rỡ, đôi mắt trong suốt như suối nguồn nhìn hắn, mái tóc dài bồng bềnh trong gió, nụ cười ấm áp nhưng cũng thật bi thương, như thể nàng biết đây sẽ là lần cuối cùng họ nhìn thấy nhau như thế này."}]
15:["$","p","13",{"className":"mb-6 text-amber-950","children":"\"Vô Thương ca ca.\" Giọng nàng vang lên, trong trẻo như chuông ngân giữa cơn mưa rào. \"Ngươi tìm thấy ta rồi.\""}]
16:["$","p","14",{"className":"mb-6 text-amber-950","children":"Hắn muốn bước tới. Muốn nắm lấy bàn tay ấy. Muốn hỏi tên nàng, muốn nhớ lại tất cả những gì họ từng có."}]
17:["$","p","15",{"className":"mb-6 text-amber-950","children":"Nhưng sợi chỉ đỏ ở cổ tay bỗng nhói đau."}]
18:["$","p","16",{"className":"mb-6 text-amber-950","children":"Từng mảnh ký ức bắt đầu rời khỏi hắn."}]
19:["$","p","17",{"className":"mb-6 text-amber-950","children":"Một cánh đồng hoa anh đào dần mờ đi. Những tiếng cười đùa dưới mái hiên tranh dần xa dần. Một lời hứa từng được thì thầm trong mưa... hắn biết đó là lời hứa gì, nhưng hình ảnh kèm theo nó đang tan biến, để lại chỉ một cảm giác trống rỗng nghẹt thở."}]
1a:["$","p","18",{"className":"mb-6 text-amber-950","children":"\"Mỗi lần ngươi dùng Dẫn Duyên...\" Tiểu Thất từng nói, giọng khô khốc vang lên từ trong ký ức. \"Ngươi sẽ mất đi một phần của chính mình để giữ lấy nàng.\""}]
1b:["$","p","19",{"className":"mb-6 text-amber-950","children":"Hắn hiểu rồi."}]
1c:["$","p","20",{"className":"mb-6 text-amber-950","children":"Dẫn Duyên không phải là dịch chuyển thân xác."}]
1d:["$","p","21",{"className":"mb-6 text-amber-950","children":"Nó là dịch chuyển ký ức."}]
1e:["$","p","22",{"className":"mb-6 text-amber-950","children":"Và cái giá... là chính ký ức ấy."}]
1f:["$","p","23",{"className":"mb-6 text-amber-950","children":"---"}]
20:["$","p","24",{"className":"mb-6 text-amber-950","children":"Tiếng chuông trấn môn lại vang lên, đánh thức Tần Vô Thương khỏi cơn mơ kỳ lạ. Hắn tỉnh dậy trên chiếu rơm, sợi chỉ đỏ đã mờ đi một chút, không còn rực rỡ như hồng ngọc nữa mà chỉ còn là một sợi tơ mỏng manh, nhợt nhạt như máu cũ."}]
21:["$","p","25",{"className":"mb-6 text-amber-950","children":"Trên nền đá cạnh chiếu, dòng chữ cũ đã biến mất."}]
22:["$","p","26",{"className":"mb-6 text-amber-950","children":"Thay vào đó, một dòng chữ mới hiện ra, nét chữ run rẩy như thể người viết đang khóc:"}]
23:["$","p","27",{"className":"mb-6 text-amber-950","children":"**\"Lần này, ngươi đã quên tiếng cười của ta...\"**"}]
24:["$","p","28",{"className":"mb-6 text-amber-950","children":"**\"Nhưng ta vẫn ở đây. Dưới đáy Vong Xuyên.\"**"}]
25:["$","p","29",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cúi đầu, nhìn vào vết sẹo lõm nhỏ ở cổ tay. Nó không còn nhức nhói nữa. Chỉ là một cảm giác trống rỗng, lạnh buốt, như thể vừa có một phần của linh hồn hắn vĩnh viễn rời bỏ."}]
26:["$","p","30",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm."}]
27:["$","p","31",{"className":"mb-6 text-amber-950","children":"Dù có phải quên sạch ký ức."}]
28:["$","p","32",{"className":"mb-6 text-amber-950","children":"Dù có phải mất đi chính mình."}]
29:["$","p","33",{"className":"mb-6 text-amber-950","children":"Hắn sẽ cứu được nàng."}]
2a:["$","p","34",{"className":"mb-6 text-amber-950","children":"---"}]
2b:["$","p","35",{"className":"mb-6 text-amber-950","children":"*Chú thích: Chương 11 chính thức thiệt lập cơ chế \"Dẫn Duyên\" (Tầng II) - dịch chuyển qua sợi chỉ đỏ bằng cách đánh đổi ký ức. Tần Vô Thương lần đầu tiên thấy nàng trong cánh đồng hoa anh đào, nhưng cái giá ngay lập tức là mất đi tiếng cười của nàng. Kết chương bằng dòng chữ của nàng từ dưới đáy Vong Xuyên.*"}]
2c:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-10","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 10: Sợi Chỉ Đỏ Trong Mưa"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-12","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 12: Một Tấc Hồng Tim Trong Mưa"}]]}]}]]}]}]}]
