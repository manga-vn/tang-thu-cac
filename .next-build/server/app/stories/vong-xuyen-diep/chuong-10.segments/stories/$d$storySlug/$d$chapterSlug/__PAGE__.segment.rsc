0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 10: Sợi Chỉ Đỏ Trong Mưa"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Mưa tại Vô Tướng Môn không giống như ở Thanh Nhai thôn."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Nó không rơi từ trời cao, mà như thể đang rỉ ra từ những bức tường đá xám xịt, từ khe nứt của từng phiến ngói cổ, từ lớp rêu xanh mọc dày trên bậc thềm. Thanh Nhai thôn có mưa rào rạt, mưa rừng, mưa tầm tã làm ngập lụt ruộng đồng. Còn ở đây, mưa là một thứ độ ẩm đặc quánh, lạnh lẽo, thấm vào da thịt như thể chính ngôi môn phái này đang chối bỏ sự hiện diện của những kẻ phàm tục."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đứng dưới hiên thư viện cổ, cây chổi tre trong tay vẫn quen thuộc, nhưng cảm giác trong lồng ngực đã khác hẳn."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Hắn không còn cảm nhận hơi ấm hay cái lạnh trên thân người khác như lúc ở thôn nhỏ. Những rung động mơ hồ ấy đã biến mất, thay vào đó là một thứ sắc lạnh hơn, sâu thẳm hơn."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"Hắn cảm thấy **sự kết nối**."}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Mỗi khi hắn nhìn vào những cuộn thẻ tre xám xịt xếp dài tít tắp trên kệ gỗ mục, hắn thấy những sợi chỉ vô hình đang rung động. Có sợi đỏ thẫm như máu cũ, sợi xanh nhạt như sương mai, sợi trắng bệch như xương tàn. Chúng đan xen vào nhau, chồng chéo lên nhau, tạo thành một tấm lưới khổng lồ bao phủ toàn bộ Vô Tướng Môn, từ đỉnh tháp chuông cao nhất đến tận hầm mộ sâu nhất."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Những sợi chỉ ấy buộc vào cổ tay các đệ tử khi họ tu luyện, buộc vào ngón tay các trưởng lão khi họ nghị sự, buộc vào linh thú khi chúng gầm gừ trong chuồng. Mỗi một sinh linh trong môn phái này đều bị trói buộc bởi ít nhất một sợi chỉ, kết nối họ với Đại Đạo, với môn phái, với nghiệp quả của chính mình."}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Nhưng trên người hắn, không có sợi chỉ nào cả."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"Hắn đứng đó, giữa tấm lưới ấy, mà không một sợi chỉ nào buộc vào da thịt. Không phải vì hắn tự do. Mà là vì hắn là một **kẻ trống rỗng**."}],["$","p","9",{"className":"mb-6 text-amber-950","children":"Hắn nhìn xuống đôi bàn tay gầy guộc của mình. Không một sợi chỉ. Không một điểm kết nối. Hắn như một hố đen trong không gian tràn ngập ánh sáng, nuốt chửng mọi rung động mà không để lại dấu vết."}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]}],"$L2d"]}],null,"$L2e"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"HHZsBH1x4frJs2LPctWw0"}
3:["$","p","10",{"className":"mb-6 text-amber-950","children":"\"Ngươi lại nhìn chăm chăm vào thẻ tre nữa rồi.\" Tiểu Thất xuất hiện như mọi khi, đôi mắt đen láy không chớp mắt nhìn hắn từ sau cánh cửa gỗ mục. \"Đừng nhìn kỹ quá. Những sợi chỉ kia sẽ buộc chặt lấy ngươi, và một khi đã bị buộc, ngươi sẽ chẳng bao giờ thoát ra được.\""}]
4:["$","p","11",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương quay đầu, giọng nghẹn lại trong cổ họng: \"Tại sao ngươi lại không có sợi chỉ nào?\""}]
5:["$","p","12",{"className":"mb-6 text-amber-950","children":"Tiểu Thất im lặng một lát, đôi mắt đen ấy lướt qua người hắn rồi dừng lại ở cổ tay áo. Hắn chỉ vào đó, giọng nhỏ đến mức như thể sợ những bức tường đá cũng nghe thấy: \"Không phải ngươi không có chỉ. Là có thứ đã cắt chúng đi từ trước khi chúng kịp buộc vào.\""}]
6:["$","p","13",{"className":"mb-6 text-amber-950","children":"Hắn nhìn theo ánh mắt Tiểu Thất, nhìn xuống cổ tay áo mình. Ở đó, dưới lớp vải sờn cũ kỹ, là một vết sẹo lõm nhỏ xíu. Một vết tích như thể từng có một sợi chỉ đỏ bị nhổ đi, để lại một lỗ hổng nhỏ trên bề mặt da thịt."}]
7:["$","p","14",{"className":"mb-6 text-amber-950","children":"\"Vết sẹo lõm nhỏ của ngươi...\" Tiểu Thất thì thầm, \"Nó không cho phép sợi chỉ nào buộc vào. Ngươi là kẻ tự do, nhưng cũng là kẻ không ai nhớ đến. Khi ngươi chết đi, sẽ chẳng có sợi chỉ nào kéo linh hồn ngươi đi. Ngươi sẽ trôi dạt mãi mãi giữa hư không.\""}]
8:["$","p","15",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm. Những ngón tay gầy guộc bấu chặt vào cán chổi tre đến mức trắng bệch."}]
9:["$","p","16",{"className":"mb-6 text-amber-950","children":"Không ai nhớ đến. Khi hắn chết đi, sẽ chẳng ai..."}]
a:["$","p","17",{"className":"mb-6 text-amber-950","children":"Một buổi chiều tà, khi màn sương đỏ ửng dưới ánh hoàng hôn bao trùm lên những mái ngói cổ, Tần Vô Thương nghe thấy tiếng gọi."}]
b:["$","p","18",{"className":"mb-6 text-amber-950","children":"Không phải từ nước ao đen ngòm dưới chân thư viện. Không phải từ giấc mơ về chiếc ô giấy đỏ. Mà là từ những cuộn thẻ tre."}]
c:["$","p","19",{"className":"mb-6 text-amber-950","children":"Tiếng gọi vang lên từ bề mặt tre nhẵn bóng, như thể nàng đang đứng ngay trong từng thẻ gỗ, thì thầm qua những nét khắc cổ tự. Hắn vội vàng cầm lấy cuộn thẻ tre của Trần Đại Thụ - một đệ tử đã chết trong lúc tu luyện năm ngoái."}]
d:["$","p","20",{"className":"mb-6 text-amber-950","children":"Trên bề mặt, cái tên ấy đã mờ đi nhiều, nhưng những sợi chỉ vô hình vẫn buộc chặt vào nó. Hắn nhìn chằm chằm vào những nét chữ mờ mịt ấy, và tim hắn thắt lại."}]
e:["$","p","21",{"className":"mb-6 text-amber-950","children":"Nhưng ngay bên cạnh tên Trần Đại Thụ, một sợi chỉ đỏ mỏng manh đang tự hình thành."}]
f:["$","p","22",{"className":"mb-6 text-amber-950","children":"Hắn thót tim."}]
10:["$","p","23",{"className":"mb-6 text-amber-950","children":"Sợi chỉ đỏ ấy không buộc vào ngón tay hắn. Nó buộc vào **vết sẹo lõm nhỏ** ở cổ tay áo."}]
11:["$","p","24",{"className":"mb-6 text-amber-950","children":"Một cơn đau xé da chạy dọc cánh tay."}]
12:["$","p","25",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cúi đầu nhìn. Vết sẹo lõm nhỏ đang rỉ máu. Nhưng máu không thấm vào vải áo, không nhỏ xuống nền đá. Nó chảy ngược lên, thấm thẳng vào sợi chỉ đỏ. Sợi chỉ hút máu, trở nên sáng rực lên, đỏ thẫm như hồng ngọc dưới ánh hoàng hôn."}]
13:["$","p","26",{"className":"mb-6 text-amber-950","children":"Rồi..."}]
14:["$","p","27",{"className":"mb-6 text-amber-950","children":"*Vút!*"}]
15:["$","p","28",{"className":"mb-6 text-amber-950","children":"Nó chạm vào không trung, xuyên qua bức tường đá dày, xuyên qua những kệ gỗ mục, xuyên qua lớp sương mù đỏ ửng, hướng thẳng đến..."}]
16:["$","p","29",{"className":"mb-6 text-amber-950","children":"Một cánh hoa anh đào đỏ như máu đang rơi lững lờ bên bờ ao đen kịt."}]
17:["$","p","30",{"className":"mb-6 text-amber-950","children":"Hắn bỗng hiểu."}]
18:["$","p","31",{"className":"mb-6 text-amber-950","children":"Sợi chỉ đỏ này không kết nối hắn với thế gian. Không buộc hắn vào Đại Đạo hay Vô Tướng Môn."}]
19:["$","p","32",{"className":"mb-6 text-amber-950","children":"Nó kết nối hắn với **nàng**."}]
1a:["$","p","33",{"className":"mb-6 text-amber-950","children":"Mỗi giọt máu hắn rỉ ra, sợi chỉ lại dài ra một chút, kéo hắn lại gần hơn với bóng hình dưới tán ô đỏ. Nhưng đồng thời, một ký ức về nàng lại mờ đi một chút."}]
1b:["$","p","34",{"className":"mb-6 text-amber-950","children":"Hắn nhớ rằng nàng từng cười với hắn."}]
1c:["$","p","35",{"className":"mb-6 text-amber-950","children":"Một nụ cười dưới mưa, khi chiếc ô giấy đỏ che chở cho cả hai đứa trẻ. Hắn biết mình từng thấy nụ cười ấy. Hắn biết nó ấm áp như ánh mặt trời đầu đông. Hắn biết nó sáng bừng lên cả một góc trời xám xịt của Thanh Nhai thôn."}]
1d:["$","p","36",{"className":"mb-6 text-amber-950","children":"Nhưng khi cố hình dung nụ cười ấy, trong đầu hắn chỉ còn một khoảng trắng lạnh ngắt."}]
1e:["$","p","37",{"className":"mb-6 text-amber-950","children":"Không có khóe môi cong lên. Không có ánh mắt trong suốt như suối nguồn. Không có tiếng cười trong trẻo như chuông ngân. Chỉ còn cảm giác rằng mình vừa đánh mất một thứ rất đẹp. Và đáng sợ hơn cả là - hắn không còn nhớ nó đẹp đến mức nào."}]
1f:["$","p","38",{"className":"mb-6 text-amber-950","children":"\"Đã... mất đi một ký ức hạnh phúc...\" Hắn thì thầm, giọng run rẩy trong cơn mưa rỉ rả."}]
20:["$","p","39",{"className":"mb-6 text-amber-950","children":"Sợi chỉ đỏ vẫn sáng rực trên vết sẹo, như một sinh linh vừa tỉnh giấc sau giấc ngủ dài. Nó kéo căng, rung lên bần bật, đòi hỏi thêm máu, đòi hỏi thêm ký ức, đòi hỏi thêm những mảnh ghép của linh hồn hắn."}]
21:["$","p","40",{"className":"mb-6 text-amber-950","children":"Cánh hoa anh đào bên bờ ao bỗng tàn héo."}]
22:["$","p","41",{"className":"mb-6 text-amber-950","children":"Những cánh hoa mỏng manh rụng xuống mặt nước đen kịt, tạo thành những vòng tròn loang lổ như vết mực rơi xuống hồ. Từ trong lòng nước, một bóng hình nhỏ bé mờ ảo nổi lên, đôi mắt trong suốt như suối nguồn nhìn hắn, mái tóc dài bồng bềnh trong dòng nước đen..."}]
23:["$","p","42",{"className":"mb-6 text-amber-950","children":"Nhưng lần này, nàng không mỉm cười."}]
24:["$","p","43",{"className":"mb-6 text-amber-950","children":"Nàng đang khóc."}]
25:["$","p","44",{"className":"mb-6 text-amber-950","children":"Những giọt nước mắt trong suốt rơi xuống mặt nước đen, nhưng không tan biến. Chúng chìm xuống đáy hồ, nơi những ký ức bị nghiền nát đang chờ đợi để trở thành năng lượng nuôi sống Tiên Cảnh."}]
26:["$","p","45",{"className":"mb-6 text-amber-950","children":"Nàng khóc vì hắn đã quên nụ cười của nàng."}]
27:["$","p","46",{"className":"mb-6 text-amber-950","children":"Nàng khóc vì mỗi lần hắn tìm đến nàng, hắn lại đánh mất một phần của chính mình."}]
28:["$","p","47",{"className":"mb-6 text-amber-950","children":"Nàng khóc vì sợi chỉ đỏ kia không phải là duyên phận. Nó là sợi xích trói buộc cả hai vào một bi kịch vĩnh cửu."}]
29:["$","p","48",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đứng đó, dưới hiên thư viện cổ, nhìn bóng hình nàng đang chìm dần xuống đáy Vong Xuyên. Sợi chỉ đỏ vẫn căng ngắt giữa hắn và nàng, rung lên trong cơn mưa rỉ rả."}]
2a:["$","p","49",{"className":"mb-6 text-amber-950","children":"Hắn không thể buông bỏ."}]
2b:["$","p","50",{"className":"mb-6 text-amber-950","children":"Dù có mất đi tất cả ký ức, dù có quên sạch gương mặt nàng, hắn vẫn sẽ bám lấy sợi chỉ này. Bởi vì đây là thứ duy nhất chứng minh rằng nàng từng tồn tại. Rằng tình yêu của họ từng có thật."}]
2c:["$","p","51",{"className":"mb-6 text-amber-950","children":"Dù cả thế gian này đều quên đi."}]
2d:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-9","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 9: Một Nét Tên Người"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-11","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 11: Dịch Chuyển Trong Mưa"}]]}]}]]}]}]}]
2e:["$","$L2f",null,{"children":["$","$30",null,{"name":"Next.MetadataOutlet","children":"$@31"}]}]
31:null
