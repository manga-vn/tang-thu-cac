d:[["$","title","0",{"children":"Chương 2: Vong Xuyên Đàm - Vong Xuyên Điệp - Tàng Thư Các"}],["$","meta","1",{"name":"description","content":"Đọc Chương 2: Vong Xuyên Đàm của truyện Vong Xuyên Điệp trên Tàng Thư Các."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?favicon.0x3dzn~oxb6tn.ico","sizes":"256x256","type":"image/x-icon"}],["$","$L10","3",{}]]
5:["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 2: Vong Xuyên Đàm"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Mưa đã tạnh, nhưng đất trời vẫn xám xịt như thể trời chưa từng thôi giận dữ."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương đứng trước hiên, nhìn chằm chằm vào khoảng không nơi cánh hoa anh đào đỏ vừa tan biến. Trong lồng ngực, nỗi trống rỗng vừa bị rút đi lúc nãy vẫn đang rung lên từng chút một, như thể một phần ký ức đang cố gắng trồi lên nhưng lại bị ai đó ấn xuống."}],["$","p","2",{"className":"mb-6 text-amber-950","children":"\"Thương nhi! Đừng có đi ra đó!\""}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Tiếng cha hắn vang lên, giọng thấp và đầy uy nghiêm. Tại cửa chính, ông đang chặn đường ra của hắn, đôi mắt già nua không chớp mắt, tay vẫn còn cầm chiếc rìu cùn mòn."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"\"Con đã thấy cái gì ở quan tài rồi đấy.\" Ông lắc đầu, giọng run rẩy. \"Đừng đi về phía ngọn núi sau thôn. Đừng đến Vong Xuyên Đàm.\""}],["$","p","5",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương im lặng, bàn tay siết chặt vạt áo cũ, nơi vết sẹo lõm nhỏ ở cổ tay đang nhức nhói. Hắn biết cha sợ. Không phải sợ hồ, mà sợ những gì mà cái quan tài gỗ mục ấy đại diện cho."}],["$","p","6",{"className":"mb-6 text-amber-950","children":"\"Mẹ nói, sau này nếu có người gọi tên mình trong mưa... đừng trả lời.\" Hắn thì thầm, đôi mắt đen láy nhìn thẳng vào cha. \"Nhưng hôm nay, không phải mưa. Tại sao mẹ lại nói thế?\""}],["$","p","7",{"className":"mb-6 text-amber-950","children":"Mặt cha hắn tái mét. Ông lùi lại nửa bước, như thể hắn vừa nói ra một chú thuật kinh khủng."}],["$","p","8",{"className":"mb-6 text-amber-950","children":"\"Đi ngủ đi.\" Ông quay lưng, giọng cứng đờ. \"Từ hôm nay, đừng nhắc đến màu đỏ, đừng nhắc đến cái quan tài, và nhất là... đừng bao giờ đến gần cái hồ đó.\""}],["$","p","9",{"className":"mb-6 text-amber-950","children":"Nhưng khi màn đêm buông xuống, Tần Vô Thương vẫn lén dậy."}],["$","p","10",{"className":"mb-6 text-amber-950","children":"Trăng tàn khuất sau những đám mây dày đặc. Con đường mòn dẫn lên núi lót đầy bùn đất sau cơn mưa, mỗi bước chân đều kéo theo tiếng kéo léo ướt át."}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Hắn không biết mình đi đâu, chỉ biết đôi chân này từng bước đi như có một sợi dây vô hình kéo lấy."}],["$","p","12",{"className":"mb-6 text-amber-950","children":"Xung quanh, Thanh Nhai thôn chìm trong im lặng. Không một ánh đèn."}],["$","p","13",{"className":"mb-6 text-amber-950","children":"Bổng nhiên, hắn nghe thấy tiếng gọi."}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}]}],"$L32"]}]
11:["$","p","14",{"className":"mb-6 text-amber-950","children":"Không phải từ một người cụ thể. Tiếng gọi vọng ra từ trong gió, từ trong bùn đất dưới chân, từ trong không khí lạnh toát này."}]
12:["$","p","15",{"className":"mb-6 text-amber-950","children":"*\"Vô Thương ca ca...\"*\n*\"Ca ca...\"*\n*\"Vô Thương...\"*"}]
13:["$","p","16",{"className":"mb-6 text-amber-950","children":"Mỗi lần tiếng gọi vang lên, cổ tay hắn lại nhức nhói, vết sẹo lõm nhỏ như muốn nổ tung. Hắn thấy những rung động kỳ lạ trong không khí mạnh hơn bao giờ hết. Những người trong thôn đang ngủ, nhưng hắn cảm thấy những sợi dây vô hình từ họ đang rung rinh, như thể cả ngọn núi này đều đang thì thầm tên hắn."}]
14:["$","p","17",{"className":"mb-6 text-amber-950","children":"Hắn bắt đầu chạy."}]
15:["$","p","18",{"className":"mb-6 text-amber-950","children":"Qua những rặng tre già, qua những nương ngô úa vàng vì mưa lũ, hắn chạy về phía ngọn núi cấm kỵ. Ở đó, người ta bảo rằng có một cái hồ cổ xưa gọi là Vong Xuyên Đàm. Người chết từng đến đó để quên đi dương thế."}]
16:["$","p","19",{"className":"mb-6 text-amber-950","children":"**Vong Xuyên Đàm.**"}]
17:["$","p","20",{"className":"mb-6 text-amber-950","children":"Hắn dừng lại ở bờ hồ."}]
18:["$","p","21",{"className":"mb-6 text-amber-950","children":"Nước đen kịt, không một gợn sóng, nằm lặng như một tấm gương khổng lồ soi thấu linh hồn. Một mùi hơi nước tanh tách và mùi rêu mốc xộc lên nồng nặc."}]
19:["$","p","22",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương bước tới mép nước. Hắn nhìn xuống mặt hồ, tìm kiếm bóng hình của mình."}]
1a:["$","p","23",{"className":"mb-6 text-amber-950","children":"Nhưng dưới đó, không phải khuôn mặt hốc hác của hắn."}]
1b:["$","p","24",{"className":"mb-6 text-amber-950","children":"Dưới đáy nước đen kịt, có một chiếc ô giấy màu đỏ đang chìm chậm rãi."}]
1c:["$","p","25",{"className":"mb-6 text-amber-950","children":"Những cánh ô mỏng manh như cánh bướm, chầm chậm tan biến vào hư không."}]
1d:["$","p","26",{"className":"mb-6 text-amber-950","children":"Hắn cúi xuống, bàn tay thò ra định với lấy chiếc ô."}]
1e:["$","p","27",{"className":"mb-6 text-amber-950","children":"Ngay lúc đó, cổ tay hắn bỗng nhói lên một cơn đau xé da. Vết sẹo lõm nhỏ như bùng lên một ngọn lửa lạnh."}]
1f:["$","p","28",{"className":"mb-6 text-amber-950","children":"Trong khoảnh khắc ấy, một mẩu ký ức không rõ từ đâu trồi lên."}]
20:["$","p","29",{"className":"mb-6 text-amber-950","children":"Có một bàn tay từng kéo hắn vào dưới tán ô. Có một giọng nói từng mắng hắn là đồ ngốc vì đứng dầm mưa. Hắn khi ấy hình như đã nói gì đó. Một lời hứa. Rất nhỏ, rất buồn cười, nhưng hắn lại không nhớ được nội dung."}]
21:["$","p","30",{"className":"mb-6 text-amber-950","children":"Hắn chỉ biết, nếu không chạm vào chiếc ô kia, lời hứa ấy sẽ thật sự biến mất."}]
22:["$","p","31",{"className":"mb-6 text-amber-950","children":"Vì lời hứa ấy, hắn cúi xuống."}]
23:["$","p","32",{"className":"mb-6 text-amber-950","children":"Ngay lúc hắn vừa chạm tay xuống mặt nước, lồng ngực hắn lạnh toát."}]
24:["$","p","33",{"className":"mb-6 text-amber-950","children":"Một bàn tay lạnh ngắt như ngâm trong nước giếng sâu từng nắm lấy cổ tay hắn."}]
25:["$","p","34",{"className":"mb-6 text-amber-950","children":"Không phải bàn tay của kẻ thù."}]
26:["$","p","35",{"className":"mb-6 text-amber-950","children":"Là bàn tay của một cô bé."}]
27:["$","p","36",{"className":"mb-6 text-amber-950","children":"*\"Vô Thương ca ca...\"* Tiếng thì thầm vang lên từ dưới đáy hồ, vang vọng như thể nàng đang nằm ngay dưới chân hắn. *\"Sao ca ca lại đứng xa thế? Mau lại đây với ta...\"*"}]
28:["$","p","37",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương giật mình lùi lại. Hắn ngã ngửa xuống bùn. Tim đập thình thịch."}]
29:["$","p","38",{"className":"mb-6 text-amber-950","children":"Hắn chậm rãi quay đầu lại."}]
2a:["$","p","39",{"className":"mb-6 text-amber-950","children":"Sau lưng hắn, không một bóng người."}]
2b:["$","p","40",{"className":"mb-6 text-amber-950","children":"Chỉ có gió đêm lùa qua những bụi cỏ dại, mang theo tiếng thở dài của hàng vạn linh hồn vương vãi trên bờ hồ cổ."}]
2c:["$","p","41",{"className":"mb-6 text-amber-950","children":"Hắn thở dốc, cổ áo ướt sũng mồ hôi lạnh. Nhưng khi hắn lại nhìn xuống mặt nước, hình ảnh chiếc ô đỏ đã biến mất."}]
2d:["$","p","42",{"className":"mb-6 text-amber-950","children":"Chỉ còn lại một bóng hình nhỏ bé, mờ ảo như sương mai, đang đứng dưới gốc cây anh đào khô héo."}]
2e:["$","p","43",{"className":"mb-6 text-amber-950","children":"Nàng quay đầu, đôi mắt trong suốt như suối nguồn nhìn hắn, gương mặt khuất sau lớp sương mờ, nhưng hắn vẫn cảm thấy nụ cười đó, ấm áp và bi thương đến mức lồng ngực hắn đau nhói."}]
2f:["$","p","44",{"className":"mb-6 text-amber-950","children":"*\"Còn nhớ hoa anh đào không?\"*"}]
30:["$","p","45",{"className":"mb-6 text-amber-950","children":"Tiếng nói vang lên lần nữa, nhưng lần này không từ dưới nước."}]
31:["$","p","46",{"className":"mb-6 text-amber-950","children":"Mà là từ ngay phía sau lưng hắn."}]
