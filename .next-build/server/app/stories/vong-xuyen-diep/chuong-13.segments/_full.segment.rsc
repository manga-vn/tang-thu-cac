5:["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 13: Chém Vào Nhân Quả"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Trưởng lão đang nhìn hắn không phải bằng mắt mình mà bằng đôi mắt đen đặc của gã mặt sẹo, trong khoảnh khắc ấy Tần Vô Thương cảm thấy toàn bộ Vô Tướng Môn như biến thành một cơ thể khổng lồ điện chính là tim tháp chuông là xương sống những hành lang đá là mạch máu còn cơn mưa rỉ rả này là thứ máu lạnh đang chảy qua từng khe nứt của môn phái, còn hắn một tạp dịch không linh căn đang đứng trong lòng bàn tay của con quái vật ấy. Mạc Trường Phong nắm chặt kiếm: \"Đừng nhìn vào mắt hắn\" - nhưng Tần Vô Thương không đáp hắn vẫn nhìn bởi vì hắn không chỉ thấy đôi mắt kia hắn thấy sợi chỉ đen nó thô ráp nặng nề kéo dài từ điện chính đến sau gáy gã mặt sẹo khác với những sợi chỉ xanh xám của đám đệ tử sợi chỉ này không rung theo linh khí nó rung theo ý niệm mỗi lần sợi chỉ đen co lại cổ gã mặt sẹo lại giật lên một chút mỗi lần nó buông ra miệng hắn lại phát ra giọng nói già nua kia: \"Tần Vô Thương\" - giọng Trưởng lão chậm rãi vang lên: \"Ngươi có biết thứ trong cổ tay mình là gì không?\""}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương nhìn vết sẹo lõm nhỏ sợi chỉ đỏ đang căng đến mức cứa vào da thịt máu rỉ ra bị nó uống sạch trước khi kịp rơi xuống nền đá hắn nói: \"Là thứ các ngươi muốn moi ra\" - Trưởng lão bật cười tiếng cười vang từ cổ họng gã mặt sẹo nhưng lại như vọng ra từ điện chính rất xa khô sâu lạnh giống tiếng nắp quan tài bị đẩy lên từ dưới đất: \"Không\" - sợi chỉ đen sau gáy gã mặt sẹo khẽ động: \"Duyên Căn không phải thứ để moi ra\" - gã mặt sẹo bước thêm một bước: \"Duyên Căn là thứ để giết\" - mưa rơi xuống những đệ tử phía sau hắn đồng loạt cúi đầu như thể vừa nghe thấy một bí mật không nên nghe, Mạc Trường Phong biến sắc: \"Câm miệng\" - Trưởng lão nhìn sang hắn: \"Trường Phong ngươi vẫn giống năm đó biết quá ít nhưng lại tưởng mình có thể cứu người.\""}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong không nói nhưng sợi chỉ xanh nhạt giữa hắn và Tần Vô Thương bỗng rung lên rất mạnh Tần Vô Thương cảm nhận được không phải sợ hãi mà là hận một thứ hận đã bị ép xuống quá lâu lạnh đến mức không còn bốc khói, Trưởng lão nâng tay gã mặt sẹo lên khúc xương đen sì trong tay hắn khẽ rung những phù văn đỏ thẫm trên đó sáng lên từng nét như máu cũ vừa được người ta nhỏ thêm một giọt máu mới: \"Hấp Linh Cốt\" - Mạc Trường Phong nói khẽ: \"Đừng để nó chạm vào sợi chỉ của ngươi\" - Tần Vô Thương hỏi: \"Nếu chạm thì sao?\" - Mạc Trường Phong nhìn thẳng về phía trước: \"Ngươi sẽ không còn là người kéo chỉ.\""}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b"]}]}],"$L1c"]}]
11:["$","p","3",{"className":"mb-6 text-amber-950","children":"Mưa lặng đi trong một thoáng rồi gã mặt sẹo biến mất không phải dịch chuyển hắn lao tới bằng tốc độ của một tu sĩ bị cưỡng ép đốt linh khí mặt đá dưới chân hắn nổ tung từng mảng cơn mưa trước người bị xé ra thành một vệt trống dài, Mạc Trường Phong bước ngang kiếm quét lên một vệt sáng lạnh cắt vào cổ tay gã mặt sẹo nhưng Hấp Linh Cốt không né nó đập thẳng vào lưỡi kiếm Ầm! không có tiếng kim loại va nhau chỉ có tiếng thứ gì đó bị hút rỗng lưỡi kiếm của Mạc Trường Phong tối đi trong chớp mắt sợi chỉ xanh nhạt trên cổ tay hắn bị kéo lệch như có bàn tay vô hình đang túm lấy và giật mạnh về phía khúc xương đen, Mạc Trường Phong lùi nửa bước máu trào ra từ kẽ răng."}]
12:["$","p","4",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương lập tức nhìn thấy không phải Hấp Linh Cốt hút linh khí nó hút mối nối kiếm của Mạc Trường Phong mạnh vì được nối với ý niệm sát phạt người tu sĩ mạnh vì linh căn nối với thiên địa trận pháp mạnh vì mười người nối thành một lưới còn Hấp Linh Cốt đang gặm những điểm nối ấy."}]
13:["$","p","5",{"className":"mb-6 text-amber-950","children":"**Nó không phá người.**"}]
14:["$","p","6",{"className":"mb-6 text-amber-950","children":"**Nó phá duyên.**"}]
15:["$","p","7",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương lạnh sống lưng nếu thứ đó chạm vào sợi chỉ đỏ có lẽ không chỉ ký ức của hắn bị hút đi cả nàng cũng sẽ bị kéo lên khỏi Vong Xuyên nghiền nát thành thứ gì đó trong tay Trưởng lão: \"Lùi\" - Mạc Trường Phong khàn giọng: \"Không được để hắn ép sát\" - Tần Vô Thương không lùi hắn nhìn sợi chỉ đen sau gáy gã mặt sẹo rồi nhìn Hấp Linh Cốt hai thứ ấy không phải một Hấp Linh Cốt là móng vuốt sợi chỉ đen mới là tay nếu chặt móng vuốt bàn tay vẫn còn nếu chém vào tay gã mặt sẹo sẽ thoát khỏi khống chế trong một nhịp."}]
16:["$","p","8",{"className":"mb-6 text-amber-950","children":"**Chính là lúc này.**"}]
17:["$","p","9",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương không kéo mình đi hắn kéo một cánh hoa bên bờ ao cánh hoa anh đào đỏ như máu đang chìm nửa phần trong nước đen bỗng rung lên nó bay lên không nhanh không chậm chỉ vừa đủ để rơi vào khoảng trống giữa sợi chỉ đen và sau gáy gã mặt sẹo. Tần Vô Thương cắn chặt răng máu từ cổ tay trào ra sợi chỉ đỏ sáng lên mảnh đến mức gần như trong suốt hắn không dùng nó để dịch chuyển không dùng nó để né tránh mà dùng nó như một lưỡi dao một tấc hồng tim chém vào nhân quả cánh hoa đỏ xoay nhẹ sợi chỉ đen khựng lại không đứt chỉ bị cắt lệch một đường rất nhỏ nhưng gã mặt sẹo lập tức trợn mắt trong đôi mắt đen đặc của hắn màu đen rút đi nửa phần miệng hắn há ra phát ra một tiếng gào không giống người Hấp Linh Cốt lệch khỏi cổ tay Tần Vô Thương nó sượt qua vai hắn một mảng da thịt lập tức mất đi cảm giác không đau không máu chỉ trống rỗng như thể phần vai ấy chưa từng thuộc về hắn."}]
18:["$","p","10",{"className":"mb-6 text-amber-950","children":"Cùng lúc kiếm của Mạc Trường Phong đã đến lưỡi kiếm đâm xuyên qua cổ tay cầm Hấp Linh Cốt của gã mặt sẹo máu đen phun ra khúc xương đen rơi xuống nền đá mưa vừa chạm vào nó đã bốc khói trắng: \"Đi!\" - Mạc Trường Phong quát lần đầu tiên giọng hắn thật sự mất bình tĩnh, Tần Vô Thương muốn nhấc chân nhưng đầu gối khuỵu xuống cái giá đến không ồn ào không xé rách chỉ là một cánh cửa trong ký ức lặng lẽ đóng lại hắn thấy Thanh Nhai thôn thấy con đường đất sau mưa thấy một bàn tay nhỏ bé chìa về phía mình dưới tán ô đỏ hắn biết đó là tay nàng biết mình từng nắm lấy bàn tay ấy biết lòng bàn tay nàng từng ấm từng mềm từng run lên vì lạnh nhưng cảm giác ấy đang tan đi hắn cố nắm lại trong trí nhớ không được hơi ấm biến mất trước rồi đến sự mềm mại rồi đến cái rung rất khẽ nơi đầu ngón tay cuối cùng hắn chỉ còn nhớ rằng mình từng nắm tay một người nhưng không còn nhớ bàn tay ấy đã khiến hắn muốn sống tiếp như thế nào."}]
19:["$","p","11",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cúi đầu nước mưa chảy xuống mặt hắn hay nước mắt hắn không phân biệt được dưới mặt ao nàng co rúm lại phần cánh tay đã mờ trước đó nay tan thêm một đoạn những đốm sáng trắng lặng lẽ rơi xuống đáy nước đen nàng nhìn hắn đau đớn bất lực nhưng vẫn lắc đầu đừng nữa, Tần Vô Thương muốn nói xin lỗi nhưng Mạc Trường Phong đã túm lấy cổ áo hắn kéo mạnh về phía bờ ao phía sau gã mặt sẹo quỳ một gối trên nền đá cổ tay bị đâm thủng Hấp Linh Cốt nằm cách hắn vài bước mà sợi chỉ đen sau gáy hắn lại bắt đầu liền lại từ điện chính giọng Trưởng lão vang lên lần nữa không còn qua miệng gã mặt sẹo mà vang trong cơn mưa: \"Chém được một vết vào nhân quả của ta…\" - cả Vô Tướng Môn rung nhẹ: \"Rất tốt.\""}]
1a:["$","p","12",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương bị Mạc Trường Phong kéo đi nhưng vẫn ngoái đầu nhìn trong màn mưa đỏ sợi chỉ đen sau gáy gã mặt sẹo đang khép lại từng chút một chậm nhưng chắc chắn Trưởng lão chưa hề bị thương thật sự hắn chỉ thấy thú vị điều đó còn đáng sợ hơn, Mạc Trường Phong kéo hắn đến sát mép ao tay áo hắn vung lên đánh vào một phiến đá phủ rêu bên cạnh phiến đá lún xuống mặt nước ao đen bỗng xoáy tròn một lối xuống hiện ra dưới nước sâu hun hút lạnh đến mức mưa rơi gần đó cũng hóa thành sương trắng: \"Đường hầm ở dưới ao\" - Mạc Trường Phong nói, Tần Vô Thương nhìn xuống dưới mặt nước bóng hình nàng đang ở rất gần lối xuống nàng nhìn hắn một bên là đường sống một bên là nàng."}]
1b:["$","p","13",{"className":"mb-6 text-amber-950","children":"Mạc Trường Phong nắm chặt vai hắn: \"Đừng nhìn nữa\" - Tần Vô Thương không nhúc nhích, Mạc Trường Phong gằn giọng: \"Ngươi cứu được nàng hay không phải sống đã\" - câu đó như một thanh kiếm lạnh cắm vào tai hắn phải sống đã, Tần Vô Thương nhìn nàng lần cuối hắn không còn nhớ nụ cười của nàng không còn nhớ tiếng hát không còn nhớ cách nàng gọi tên hắn không còn nhớ hơi ấm bàn tay nàng nhưng hắn vẫn biết nàng rất quan trọng quan trọng đến mức dù ký ức bị gặm sạch phần trống rỗng còn lại trong hắn vẫn đau vì nàng, hắn cúi đầu: \"Chờ ta\" - không biết nàng có nghe thấy không, Mạc Trường Phong không chờ thêm hắn kéo Tần Vô Thương nhảy xuống ao đen nước lạnh nuốt chửng hai người trước khi bóng tối khép lại Tần Vô Thương nhìn thấy trên bờ gã mặt sẹo chậm rãi đứng dậy sau lưng hắn sợi chỉ đen đã liền lại nhưng trên đó có một vết cắt rất nhỏ mảnh như tơ đỏ như máu và từ điện chính xa xăm tiếng Trưởng lão khàn khàn vang lên lần cuối: \"Đem hắn trở về còn sống cũng được chỉ cần cổ tay còn nguyên.\""}]
1c:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-12","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 12: Một Tấc Hồng Tim Trong Mưa"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","div",null,{"className":"w-full sm:w-auto invisible","aria-hidden":"true","children":["$","div",null,{"className":"px-4 py-3"}]}]]}]}]}]
