0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#F8F5EF]","children":[["$","div",null,{"className":"sticky top-0 bg-[#FFFDF8] border-b border-[#E5E0D8] z-40","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-3 flex items-center justify-between","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium flex items-center gap-1","children":"← Quay lại"}],["$","$L2",null,{"href":"/stories","className":"text-amber-800 hover:text-amber-950 transition-colors text-sm font-medium","children":"Danh sách truyện"}]]}]}],["$","div",null,{"className":"bg-[#FFFDF8] border-b border-[#E5E0D8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"text-amber-800/60 hover:text-amber-950 text-sm mb-2 inline-block","children":"Vong Xuyên Điệp"}],["$","h1",null,{"className":"text-xl md:text-2xl font-bold text-amber-950","children":"Chương 6: Người Đã Quên Tên Mình"}]]}]}],["$","article",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-8","children":["$","div",null,{"className":"prose prose-gray max-w-none","children":[["$","p","0",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương không ngủ được."}],["$","p","1",{"className":"mb-6 text-amber-950","children":"Hắn ngồi bên cạnh chiếu nằm, nhìn chằm chằm vào dòng chữ **\"Tên ta... đã bị xóa rồi sao?\"** đang mờ dần trên nền đá. Tiểu Thất đã cảnh báo: *\"Vì khi ngươi còn nhớ họ, họ sẽ bắt đầu nhớ lại chính mình.\"*"}],["$","p","2",{"className":"mb-6 text-amber-950","children":"Hắn phải biết thêm về Trần Đại Thụ."}],["$","p","3",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, khi màn sương còn chưa tan, Tần Vô Thương không lau chùi thẻ tre như mọi ngày. Hắn ngồi bệt xuống nền đá, cầm cuộn thẻ tre của Trần Đại Thụ trên tay, nhìn chằm chằm vào ba chữ ấy."}],["$","p","4",{"className":"mb-6 text-amber-950","children":"\"Ngươi làm gì thế?\" Tiểu Thất xuất hiện như mọi khi, đôi mắt đen láy không chớp mắt nhìn hắn."}],["$","p","5",{"className":"mb-6 text-amber-950","children":"\"Ta muốn biết thêm về người này.\""}],["$","p","6",{"className":"mb-6 text-amber-950","children":"Tiểu Thất lắc đầu, giọng khô khốc: \"Càng nhớ, người bị xóa càng tỉnh. Ngươi muốn đánh thức một linh hồn đã chìm sâu dưới Vong Xuyên sao?\""}],["$","p","7",{"className":"mb-6 text-amber-950","children":"\"Nếu hắn tỉnh dậy, hắn sẽ nhớ gì?\""}],["$","p","8",{"className":"mb-6 text-amber-950","children":"\"Hắn sẽ nhớ mình từng tồn tại.\" Tiểu Thất nhìn xuống đôi bàn tay gầy guộc của hắn, giọng bỗng trầm xuống. \"Nhưng hắn chưa chắc nhớ nổi tên mình. Cũng chưa chắc nhớ nổi người thân. Vì từ khoảnh khắc bị xóa tên, những thứ ấy đã không còn thuộc về hắn nữa.\""}],["$","p","9",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương siết chặt cuộn thẻ tre."}],["$","p","10",{"className":"mb-6 text-amber-950","children":"Hắn biết mình không nên làm."}],["$","p","11",{"className":"mb-6 text-amber-950","children":"Nhưng nếu ngay cả hắn cũng không gọi cái tên kia, trên đời này còn ai dám gọi nữa?"}],["$","p","12",{"className":"mb-6 text-amber-950","children":"Đêm đó, hắn nằm trên chiếu rơm, đặt cuộn thẻ tre của Trần Đại Thụ lên ngực. Từ vết sẹo lõm nhỏ ở cổ tay áo, máu lại rỉ ra, nhỏ giọt lên bề mặt tre nhẵn bóng."}],["$","p","13",{"className":"mb-6 text-amber-950","children":"Không thấm."}],["$","p","14",{"className":"mb-6 text-amber-950","children":"Giọt máu lăn trên mặt tre như giọt nước trên lá sen, để lại một vệt đỏ tươi. Rồi vệt đỏ bắt đầu biến đổi, không hiện ra chữ, mà hiện ra một hình ảnh."}],["$","p","15",{"className":"mb-6 text-amber-950","children":"Một người đàn ông trung niên, gương mặt hiền từ, đôi mắt nhắm nghiền, đang đứng giữa mưa xối xả."}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a"]}]}],"$L3b"]}],null,"$L3c"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"HHZsBH1x4frJs2LPctWw0"}
3:["$","p","16",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương bỗng thấy mình không còn nằm trong phòng đá nữa."}]
4:["$","p","17",{"className":"mb-6 text-amber-950","children":"Hắn đứng giữa một con đường làng lầy lội, mưa rơi xối xả, những giọt nước đập vào mặt hắn đau nhói. Trước mặt hắn, người đàn ông ấy đang lảo đảo bước đi, máu từ ngực thấm đẫm áo vải thô, đôi mắt trống rỗng như hai hố đen."}]
5:["$","p","18",{"className":"mb-6 text-amber-950","children":"\"Trần bá!\" Hắn gọi to."}]
6:["$","p","19",{"className":"mb-6 text-amber-950","children":"Người đàn ông dừng lại."}]
7:["$","p","20",{"className":"mb-6 text-amber-950","children":"Hắn quay đầu, đôi mắt trống rỗng nhìn thẳng vào hắn, nhưng trong mắt không có sự nhận biết. Chỉ có một nỗi hoang mang tột độ, như thể người ấy đang cố gắng nhớ ra mình là ai."}]
8:["$","p","21",{"className":"mb-6 text-amber-950","children":"\"Ngươi... gọi ta sao?\" Giọng nói khàn đặc, như thể vừa nhai sỏi đá."}]
9:["$","p","22",{"className":"mb-6 text-amber-950","children":"\"Trần Đại Thụ.\" Tần Vô Thương nói to, rõ ràng từng chữ."}]
a:["$","p","23",{"className":"mb-6 text-amber-950","children":"Người đàn ông run rẩy toàn thân."}]
b:["$","p","24",{"className":"mb-6 text-amber-950","children":"Hắn nắm lấy đầu mình, những ngón tay gầy guộc cào cấu vào da thịt, để lại những vết trầy đỏ hằn. Đôi mắt trống rỗng bỗng ầng lên một nỗi đau nhói, rồi hai hàng nước mắt tuôn rơi."}]
c:["$","p","25",{"className":"mb-6 text-amber-950","children":"\"Trần Đại Thụ...\" Hắn lẩm bẩm, giọng khóc cười điên dại. \"Ta... ta là Trần Đại Thụ?\""}]
d:["$","p","26",{"className":"mb-6 text-amber-950","children":"\"Phải. Ngươi là Trần Đại Thụ.\""}]
e:["$","p","27",{"className":"mb-6 text-amber-950","children":"\"Ta có vợ.\" Hắn bỗng nói, giọng run rẩy. \"Ta có một đứa con gái nhỏ...\""}]
f:["$","p","28",{"className":"mb-6 text-amber-950","children":"Hắn ngước nhìn Tần Vô Thương, đôi mắt đẫm lệ, nhưng sâu trong đó là một khoảng trống đen ngòm, như thể có ai đó vừa dùng dao cạo sạch một phần ký ức."}]
10:["$","p","29",{"className":"mb-6 text-amber-950","children":"\"Nhưng tên nó là gì?\" Hắn gào thét, tiếng thét vang vọng giữa màn mưa. \"Ta nhớ nó mặc váy đỏ. Ta nhớ nó cầm một chiếc ô giấy màu đỏ. Ta nhớ tiếng nó gọi... gọi ta là...\""}]
11:["$","p","30",{"className":"mb-6 text-amber-950","children":"Hắn khụy xuống bùn, hai tay bưng mặt, khóc nức nở."}]
12:["$","p","31",{"className":"mb-6 text-amber-950","children":"\"Ta không nhớ tên nó. Ta không nhớ tên con gái mình.\""}]
13:["$","p","32",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương cúi xuống, nắm lấy vai người đàn ông ấy. \"Nó là đứa con gái nhỏ của ngươi. Nó từng đứng dưới tán ô đỏ, gọi ngươi...\""}]
14:["$","p","33",{"className":"mb-6 text-amber-950","children":"\"Ô đỏ?\" Trần Đại Thụ ngẩng đầu, gương mặt đẫm nước mưa và nước mắt. \"Ta từng thấy một chiếc ô đỏ chìm dưới nước... Vong Xuyên đã lấy đi mọi thứ, nhưng mỗi khi ta nhớ đến nó, dưới đáy hồ lại có thứ gì đó kéo nó xuống sâu hơn...\""}]
15:["$","p","34",{"className":"mb-6 text-amber-950","children":"Hắn bỗng im bặt."}]
16:["$","p","35",{"className":"mb-6 text-amber-950","children":"Đôi mắt trống rỗng lại trở nên đen ngòm, như thể vừa có một lực hút vô hình rút cạn ý thức của hắn."}]
17:["$","p","36",{"className":"mb-6 text-amber-950","children":"\"Ta từng có một đứa con gái...\" Hắn lẩm bẩm, giọng bỗng lạnh lẽo. \"Nhưng mỗi lần ta nhớ đến nó, dưới Vong Xuyên lại có thứ gì đó kéo nó xuống sâu hơn.\""}]
18:["$","p","37",{"className":"mb-6 text-amber-950","children":"Rồi hắn nhìn thẳng vào mắt Tần Vô Thương, giọng nói vang lên như tiếng thì thầm từ dưới đáy nước:"}]
19:["$","p","38",{"className":"mb-6 text-amber-950","children":"\"Ngươi... ngươi cũng đang nhớ một người con gái dưới tán ô đỏ phải không?\""}]
1a:["$","p","39",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương lùi lại."}]
1b:["$","p","40",{"className":"mb-6 text-amber-950","children":"\"Đừng nhớ nó quá nhiều.\" Trần Đại Thụ đứng dậy, thân hình trong suốt dần biến mất vào màn mưa. \"Vì mỗi lần ngươi nhớ, Vong Xuyên sẽ càng kéo nó xuống sâu hơn. Đến một lúc, kể cả ngươi cũng sẽ quên nó từng tồn tại...\""}]
1c:["$","p","41",{"className":"mb-6 text-amber-950","children":"Hắn biến mất vào màn mưa."}]
1d:["$","p","42",{"className":"mb-6 text-amber-950","children":"Chỉ còn lại tiếng cười điên dại vang vọng:"}]
1e:["$","p","43",{"className":"mb-6 text-amber-950","children":"\"Ta là Trần Đại Thụ... Ta là Trần Đại Thụ... Tại sao ta không nhớ tên con gái mình...\""}]
1f:["$","p","44",{"className":"mb-6 text-amber-950","children":"---"}]
20:["$","p","45",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương tỉnh dậy, ngồi bật dậy trên chiếu rơm, toát mồ hôi lạnh."}]
21:["$","p","46",{"className":"mb-6 text-amber-950","children":"Cuộn thẻ tre vẫn nằm trên ngực hắn, nhưng bề mặt tre đã trở nên trắng trơn, không còn hình ảnh, không còn tên gọi. Chỉ có một dòng chữ nhỏ xíu, như thể có ai đã dùng móng tay khắc xuống trong đêm:"}]
22:["$","p","47",{"className":"mb-6 text-amber-950","children":"**\"Đã quên. Lần này thật sự quên rồi.\"**"}]
23:["$","p","48",{"className":"mb-6 text-amber-950","children":"Hắn siết chặt nắm đấm, vết sẹo ở cổ tay lại nhức nhói."}]
24:["$","p","49",{"className":"mb-6 text-amber-950","children":"Trần Đại Thụ đã tỉnh dậy khi nghe tên mình. Nhưng sau khi tỉnh, ông lại quên sạch sẽ, lần này thật sự quên, không còn cơ hội nào để nhớ lại."}]
25:["$","p","50",{"className":"mb-6 text-amber-950","children":"Bởi vì Tần Vô Thương đã nhớ hộ ông."}]
26:["$","p","51",{"className":"mb-6 text-amber-950","children":"Và chính sự nhớ đó, đã đẩy ông chìm sâu hơn vào Vong Xuyên."}]
27:["$","p","52",{"className":"mb-6 text-amber-950","children":"Hắn nhìn ra ngoài cửa sổ, nơi màn sương đang tan dần."}]
28:["$","p","53",{"className":"mb-6 text-amber-950","children":"Trong đầu hắn, hình ảnh cô bé dưới tán ô đỏ vẫn hiện rõ từng chi tiết. Đôi mắt trong suốt như suối nguồn. Giọng nói trong trẻo: *\"Vô Thương ca ca, mau vào đây, mưa to lắm...\"*"}]
29:["$","p","54",{"className":"mb-6 text-amber-950","children":"Nếu hắn tiếp tục nhớ nàng, liệu nàng cũng sẽ bị kéo xuống sâu hơn dưới đáy Vong Xuyên?"}]
2a:["$","p","55",{"className":"mb-6 text-amber-950","children":"Hắn không thể để chuyện đó xảy ra."}]
2b:["$","p","56",{"className":"mb-6 text-amber-950","children":"Nhưng hắn cũng không thể quên."}]
2c:["$","p","57",{"className":"mb-6 text-amber-950","children":"---"}]
2d:["$","p","58",{"className":"mb-6 text-amber-950","children":"Sáng hôm sau, Tiểu Thất đến, nhìn thẳng vào cuộn thẻ tre trên tay hắn."}]
2e:["$","p","59",{"className":"mb-6 text-amber-950","children":"\"Hắn tỉnh chưa?\" Tiểu Thất hỏi, giọng không cảm xúc."}]
2f:["$","p","60",{"className":"mb-6 text-amber-950","children":"\"Đã quên.\" Tần Vô Thương đáp, giọng nghẹn lại. \"Lần này thật sự quên rồi.\""}]
30:["$","p","61",{"className":"mb-6 text-amber-950","children":"Tiểu Thất im lặng một lát, rồi gật đầu: \"Ngươi gọi tên hắn, hắn tỉnh. Hắn tỉnh, hắn đau. Hắn đau, Vong Xuyên kéo hắn xuống sâu hơn.\""}]
31:["$","p","62",{"className":"mb-6 text-amber-950","children":"Nó nhìn thẳng vào mắt hắn, đôi mắt đen láy không chớp mắt:"}]
32:["$","p","63",{"className":"mb-6 text-amber-950","children":"\"Đó là lý do ở đây không ai gọi tên người chết.\""}]
33:["$","p","64",{"className":"mb-6 text-amber-950","children":"Nó nhìn thẳng vào mắt hắn, đôi mắt đen láy không chớp mắt:\n\"Đó là lý do ở đây không ai gọi tên người chết.\"\nRồi nó hỏi, giọng nhẹ đến mức gần như tan vào sương:\n\"Ngươi còn muốn nhớ thêm ai nữa không?\""}]
34:["$","p","65",{"className":"mb-6 text-amber-950","children":"Tần Vô Thương lắc đầu."}]
35:["$","p","66",{"className":"mb-6 text-amber-950","children":"Nhưng trong lồng ngực hắn, nơi vết sẹo lõm nhỏ, một cảm giác ấm áp chợt lấp đầy, rồi nhanh chóng lạnh đi."}]
36:["$","p","67",{"className":"mb-6 text-amber-950","children":"Hắn biết, hắn sẽ không bao giờ quên nàng."}]
37:["$","p","68",{"className":"mb-6 text-amber-950","children":"Dù cái giá phải trả, là nhìn nàng chìm sâu mãi mãi dưới đáy Vong Xuyên."}]
38:["$","p","69",{"className":"mb-6 text-amber-950","children":"---"}]
39:["$","p","70",{"className":"mb-6 text-amber-950","children":"Đêm đó, trên nền đá cạnh chiếu nằm, một dòng chữ mới hiện ra, nét chữ run rẩy như thể người viết đang khóc:"}]
3a:["$","p","71",{"className":"mb-6 text-amber-950","children":"**\"Đừng nhớ ta nữa. Vong Xuyên sẽ kéo ngươi xuống...\"**"}]
3b:["$","div",null,{"className":"border-t border-[#E5E0D8] bg-[#FFFDF8]","children":["$","div",null,{"className":"max-w-2xl md:max-w-prose mx-auto px-4 py-6","children":["$","div",null,{"className":"flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center","children":[["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-5","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương trước"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px]","children":"Chương 5: Thẻ Tre Không Tên"}]]}]}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep","className":"w-full sm:w-auto px-4 py-3 bg-[#8B5E34] text-white rounded-lg text-sm font-medium hover:bg-[#6F4726] transition-colors text-center","children":"Danh sách chương"}],["$","$L2",null,{"href":"/stories/vong-xuyen-diep/chuong-7","className":"w-full sm:w-auto px-4 py-3 bg-[#FFFDF8] border border-[#E5E0D8] rounded-lg hover:bg-[#FFF5EB] transition-colors","children":["$","span",null,{"className":"flex flex-col sm:flex-row sm:items-end gap-1 sm:gap-2","children":[["$","span",null,{"className":"text-amber-800/60 text-xs","children":"Chương sau"}],["$","span",null,{"className":"text-amber-950 font-medium text-sm truncate max-w-[120px] text-right","children":"Chương 7: Đừng Nhớ Ta Nữa"}]]}]}]]}]}]}]
3c:["$","$L3d",null,{"children":["$","$3e",null,{"name":"Next.MetadataOutlet","children":"$@3f"}]}]
3f:null
